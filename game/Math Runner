<!DOCTYPE html>
<html lang="gu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Math Logic Run Pro</title>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Hind+Vadodara:wght@700&display=swap');

    body, html { 
        margin: 0; padding: 0; width: 100%; 
        background: #050510; font-family: 'Hind Vadodara', sans-serif; 
        overflow-y: auto; 
    }

    #gameContainer {
        position: relative; 
        width: 100%; height: 85vh; min-height: 500px;
        margin: 0 auto; background: linear-gradient(135deg, #050515, #101030);
        overflow: hidden; box-shadow: 0 0 30px rgba(0,255,255,0.2);
        border-bottom: 3px solid #00ffff;
    }

    .fullscreen-mode {
        position: fixed !important; top: 0 !important; left: 0 !important;
        width: 100vw !important; height: 100vh !important; height: 100dvh !important; 
        z-index: 99999 !important; margin: 0 !important; border-radius: 0 !important;
    }

    canvas { display: block; width: 100%; height: 100%; cursor: crosshair; }

    .ui-layer {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        pointer-events: none; display: flex; flex-direction: column; justify-content: space-between; z-index: 20;
    }

    #topBar {
        padding: 15px 20px; display: flex; justify-content: space-between; align-items: center;
        color: #00ffff; font-size: 20px; text-shadow: 0 0 15px #00ffff; font-weight: bold;
        background: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent);
        pointer-events: auto;
    }

    .exit-btn {
        background: #ff1744; color: white; border: 2px solid #ff5252;
        padding: 6px 18px; border-radius: 20px; font-size: 14px; cursor: pointer;
        display: none; box-shadow: 0 0 15px rgba(255, 23, 68, 0.5); font-weight: bold;
        transition: transform 0.1s;
    }
    .exit-btn:active { transform: scale(0.9); }

    #timerContainer { width: 100%; height: 8px; background: rgba(0,0,0,0.5); position: absolute; top: 0; z-index: 25; }
    #timerBar { width: 100%; height: 100%; background: linear-gradient(90deg, #00ff00, #adff2f); transition: width 0.1s linear; box-shadow: 0 0 15px #00ff00; }

    #introScreen {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: radial-gradient(circle at center, #101030, #050510); color: white; z-index: 100; pointer-events: auto;
        overflow-y: auto; display: flex; flex-direction: column; align-items: center; justify-content: center;
        padding: 20px; box-sizing: border-box;
    }

    .intro-content { width: 100%; max-width: 450px; display: flex; flex-direction: column; align-items: center; padding-bottom: 20px; }
    .game-title { font-size: 36px; color: #00ffff; text-shadow: 0 0 15px #00bcd4; margin: 15px 0; text-align: center; line-height: 1.2;}
    .intro-img { width: 100%; max-width: 300px; height: auto; border-radius: 20px; border: 3px solid #00ffff; box-shadow: 0 0 20px rgba(0,255,255,0.4);}
    
    .info-box { background: rgba(0,255,255,0.05); padding: 15px 20px; border-radius: 15px; text-align: left; border-left: 5px solid #00ffff; width: 90%; margin-top: 15px; }
    .info-box ul { padding-left: 20px; margin: 0; }
    .info-box li { margin-bottom: 8px; font-size: 16px; color: #ddd; }
    
    .btn-glow {
        background: linear-gradient(45deg, #00e5ff, #2979ff); border: none; padding: 15px 50px;
        color: white; font-size: 24px; border-radius: 50px; cursor: pointer; margin-top: 30px;
        font-weight: bold; box-shadow: 0 0 25px rgba(0, 229, 255, 0.6); border: 2px solid #84ffff;
        transition: transform 0.2s;
    }
    .btn-glow:active { transform: scale(0.95); }

    .screen-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(5, 5, 15, 0.95); display: flex; flex-direction: column;
        justify-content: center; align-items: center; z-index: 30; color: white; text-align: center; pointer-events: auto;
    }

    #controls {
        display: flex; width: 100%; height: 110px; pointer-events: auto;
        gap: 15px; padding: 15px; box-sizing: border-box;
        background: linear-gradient(to top, rgba(0,0,0,0.9), transparent);
    }
    .choice-btn {
        flex: 1; background: rgba(0, 0, 0, 0.6); border: 3px solid #00ffff; color: #00ffff;
        font-size: 32px; font-weight: bold; cursor: pointer; border-radius: 20px;
        box-shadow: inset 0 0 15px rgba(0,255,255,0.2), 0 0 10px rgba(0,255,255,0.3);
        transition: background 0.1s, transform 0.1s;
    }
    .choice-btn:active { background: rgba(0,255,255,0.3); transform: scale(0.95); }

    #questionBoxDisplay {
        position: absolute; top: 18%; left: 50%; transform: translate(-50%, -50%);
        background: linear-gradient(135deg, #ff9100, #ff3d00); color: white;
        padding: 10px 35px; border-radius: 50px; font-size: 32px; font-weight: 800;
        border: 3px solid #ffe082; z-index: 15; white-space: nowrap; display: none;
        box-shadow: 0 10px 25px rgba(255, 145, 0, 0.5); text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }

    select { padding: 12px; font-size: 18px; border-radius: 10px; border: 2px solid #00ffff; background: #000; color: #00ffff; width: 85%; max-width: 300px; text-align: center; font-weight: bold; }
    
    .click-hint {
        position: absolute; bottom: 130px; width: 100%; text-align: center;
        color: #ffeb3b; font-size: 16px; font-weight: bold; pointer-events: none;
        animation: blink 1.5s infinite; text-shadow: 0 0 5px black;
    }
    @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.2; } 100% { opacity: 1; } }

</style>
</head>
<body>

<div id="gameContainer">
    <div id="timerContainer"><div id="timerBar"></div></div>
    <div id="questionBoxDisplay">5 + 3 = ?</div>

    <div id="topBar" class="ui-layer">
        <span>⭐ <span id="scoreVal">0</span> | Lvl: <span id="levelVal">1</span></span>
        <button id="exitBtn" class="exit-btn" onclick="exitFullscreen()">Exit ❌</button>
    </div>
  <span></span>
    <canvas id="gameCanvas"></canvas>

    <div class="ui-layer" id="gameUI" style="display:none;">
        <div class="click-hint">સાચા દરવાજા પર ટચ કરો 👇</div>
        <div style="flex:1;"></div> 
        <div id="controls">
            <button class="choice-btn" id="btnLeft">Left</button>
            <button class="choice-btn" id="btnRight">Right</button>
        </div>
    </div>
  <span></span>
    <div id="introScreen">
        <div class="intro-content">
            <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi8aSfoiKrAm7keOC0qeQpsl2BF8DyvUYCdwHWT4gZ1v5v-SnNV8fSL1C3reWkQgMpEj6yZnVo7h9BbTADwvAQ6cxPKhaMcvnB-4sec4oNteL7J47HMkDAVJi2-wIkc4-UQBZzhXJom-039sdlYw1clcemICboxuqLcu8TVCRY4Q05FGF6Gm6JTutSBuIz8/s320/1000571791.png" alt="Math Game" class="intro-img">
            <h1 class="game-title">🔢 ગણિત ચેલેન્જ PRO</h1>
            <div class="info-box">
                <h3 style="color:#00ffff; margin-top:0;">🚀 ફાયદા:</h3>
                <ul>
                    <li>ગણતરી ઝડપી બને છે.</li>
                    <li>એકાગ્રતા વધે છે.</li>
                </ul>
            </div>
            <button class="btn-glow" onclick="goToMenu()">Play Now ▶️</button>
        </div>
    </div>

    <div id="menuScreen" class="screen-overlay" style="display: none;">
        <h2 style="color: #00ffff; font-size: 28px;">લેવલ પસંદ કરો</h2>
        <select id="gradeSelect">
            <option value="1">ધોરણ 1-2 (સરવાળા)</option>
            <option value="2">ધોરણ 3-4 (બાદબાકી)</option>
            <option value="3">ધોરણ 5-6 (ગુણાકાર)</option>
        </select>
        <button class="btn-glow" onclick="startGame()">Start Game 🚀</button>
    </div>

    <div id="gameOverScreen" class="screen-overlay" style="display: none;">
        <h1 style="color:#ff1744; font-size: 40px; text-shadow: 0 0 20px #ff1744;">ગેમ ઓવર!</h1>
        <h2 style="font-size: 24px;">સ્કોર: <span id="finalScore" style="color: #ffeb3b; font-size: 32px;">0</span></h2>
        <button class="btn-glow" onclick="resetGame()" style="background: linear-gradient(45deg, #ff9800, #ff5722); border-color: #ffab40;">ફરી રમો 🔄</button>
    </div>
</div>
<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const questionBoxDisplay = document.getElementById('questionBoxDisplay');
    const gameUI = document.getElementById('gameUI');
    const container = document.getElementById('gameContainer');
    const exitBtn = document.getElementById('exitBtn');

    let state = 'INTRO';
    let score = 0;
    let grade = 1;
    let level = 1;
    let baseSpeed = 4; 
    let currentSpeed = 4;
    let currentTime = 100;
    
    let ball = { x: 0, y: 0, z: 0, radius: 25, targetX: 0, rotation: 0 };
    let gate = { z: 1500, active: false }; 
    let problem = { text: "", ans: 0, wrong: 0, leftIsCorrect: true };
    
    // --- 1. Audio System (3D Sounds) ---
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    let audioCtx;
    
    function initAudio() {
        if (!audioCtx) audioCtx = new AudioContext();
        if (audioCtx.state === 'suspended') audioCtx.resume();
    }

    function playSound(type) {
        if (!audioCtx) return;
        const osc = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();
        osc.connect(gainNode);
        gainNode.connect(audioCtx.destination);
        const now = audioCtx.currentTime;

        if (type === 'jump') { // દરવાજો પસંદ કરતી વખતે
            osc.type = 'sine'; osc.frequency.setValueAtTime(400, now);
            osc.frequency.exponentialRampToValueAtTime(800, now + 0.1);
            gainNode.gain.setValueAtTime(0.2, now); gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
            osc.start(now); osc.stop(now + 0.1);
        } else if (type === 'success') { // સાચો દરવાજો પાર કરતી વખતે
            osc.type = 'triangle'; osc.frequency.setValueAtTime(400, now);
            osc.frequency.setValueAtTime(600, now + 0.1); osc.frequency.setValueAtTime(800, now + 0.2);
            gainNode.gain.setValueAtTime(0.2, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.4);
            osc.start(now); osc.stop(now + 0.4);
        } else if (type === 'error') { // ખોટો જવાબ અથવા ટાઈમ પૂરો
            osc.type = 'sawtooth'; osc.frequency.setValueAtTime(150, now);
            osc.frequency.linearRampToValueAtTime(50, now + 0.4);
            gainNode.gain.setValueAtTime(0.3, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.4);
            osc.start(now); osc.stop(now + 0.4);
        }
    }

    // --- 2. Resize Logic ---
    function resize() {
        canvas.width = container.clientWidth;
        canvas.height = container.clientHeight;
        ball.x = canvas.width / 2;
        ball.y = canvas.height - 120; 
    }
    window.addEventListener('resize', resize);
    resize();

    // --- 3. Click/Touch on Gates (નવું ફીચર) ---
    canvas.addEventListener('mousedown', handleInput);
    canvas.addEventListener('touchstart', (e) => {
        handleInput(e.touches[0]); 
    }, {passive: false});

    function handleInput(e) {
        if(state !== 'STOPPED') return;
        const rect = canvas.getBoundingClientRect();
        const x = e.clientX - rect.left;
        
        // સ્ક્રીનના ડાબા ભાગમાં ક્લિક કરો તો ડાબો દરવાજો, જમણી બાજુ કરો તો જમણો
        if(x < canvas.width / 2) {
            chooseSide('left');
        } else {
            chooseSide('right');
        }
    }
    
    // નીચેના બટન્સ પણ કામ કરશે
    document.getElementById('btnLeft').addEventListener('click', () => chooseSide('left'));
    document.getElementById('btnRight').addEventListener('click', () => chooseSide('right'));

    // --- 4. Pseudo-Fullscreen (સ્ટેટસ બાર માટે) ---
    function openFullscreen() {
        initAudio(); // અવાજ ચાલુ કરો
        container.classList.add('fullscreen-mode');
        exitBtn.style.display = 'inline-block';
        document.body.style.overflow = 'hidden'; 
        setTimeout(resize, 100);
    }

    function exitFullscreen() {
        container.classList.remove('fullscreen-mode');
        exitBtn.style.display = 'none';
        document.body.style.overflow = 'auto'; 
        
        document.getElementById('introScreen').style.display = 'flex';
        document.getElementById('menuScreen').style.display = 'none';
        document.getElementById('gameOverScreen').style.display = 'none';
        questionBoxDisplay.style.display = 'none';
        gameUI.style.display = 'none';
        state = 'INTRO';
        setTimeout(resize, 100);
    }

    // --- 5. Game Flow Logic ---
    function goToMenu() {
        openFullscreen(); 
        document.getElementById('introScreen').style.display = 'none';
        document.getElementById('menuScreen').style.display = 'flex';
        state = 'MENU';
        resize();
    }

    function startGame() {
        document.getElementById('menuScreen').style.display = 'none';
        document.getElementById('gameOverScreen').style.display = 'none';
        gameUI.style.display = 'none'; 
        questionBoxDisplay.style.display = 'block'; 
        
        grade = parseInt(document.getElementById('gradeSelect').value);
        score = 0; level = 1;
        
        if (grade === 1) baseSpeed = 4;
        else if (grade === 2) baseSpeed = 5;
        else baseSpeed = 6;

        currentSpeed = baseSpeed;
        updateScoreBoard();
        resize(); 
        resetRound();
    }

    function updateScoreBoard() {
        document.getElementById('scoreVal').innerText = score;
        document.getElementById('levelVal').innerText = Math.floor(score / 10) + 1;
    }

    function resetRound() {
        ball.x = canvas.width / 2;
        ball.targetX = canvas.width / 2;
        ball.z = 0; gate.z = 1500; 
        
        currentTime = 100;
        document.getElementById('timerBar').style.width = '100%';
        document.getElementById('timerBar').style.background = 'linear-gradient(90deg, #00ff00, #adff2f)';
        gameUI.style.display = 'none'; 
        
        let speedIncrease = Math.floor(score / 10) * 0.5; 
        currentSpeed = baseSpeed + speedIncrease;

        generateProblem();
        questionBoxDisplay.innerText = problem.text + " = ?";
        
        state = 'RUNNING';
        loop();
    }

    function generateProblem() {
        let n1, n2, op, ans, wrong;
        let limit = grade === 1 ? 9 : (grade === 2 ? 25 : 15);
        
        n1 = Math.floor(Math.random() * limit) + 1;
        n2 = Math.floor(Math.random() * limit) + 1;
        
        if(grade === 1) op = '+';
        else if(grade === 2) op = Math.random() < 0.5 ? '+' : '-';
        else op = 'x';

        if(op === '+') ans = n1 + n2;
        if(op === '-') { if(n1<n2)[n1,n2]=[n2,n1]; ans = n1 - n2; }
        if(op === 'x') ans = n1 * n2;

        wrong = ans + (Math.floor(Math.random() * 3) + 1);
        if(wrong === ans) wrong += 1;

        problem.text = `${n1} ${op} ${n2}`;
        problem.ans = ans;
        problem.wrong = wrong;
        problem.leftIsCorrect = Math.random() < 0.5;
    }

    function chooseSide(side) {
        if(state !== 'STOPPED') return;
        playSound('jump'); // કૂદવાનો અવાજ

        let choseLeft = (side === 'left');
        let isCorrect = (choseLeft === problem.leftIsCorrect);

        ball.targetX = choseLeft ? canvas.width/4 : canvas.width*0.75;
        state = 'ANIMATING';
        gameUI.style.display = 'none'; 

        setTimeout(() => {
            if(isCorrect) {
                playSound('success'); // સાચો જવાબ
                score++; updateScoreBoard(); resetRound();
            } else {
                gameOver();
            }
        }, 600); 
    }

    function gameOver() {
        playSound('error'); // ખોટો જવાબ 
        state = 'GAMEOVER';
        document.getElementById('finalScore').innerText = score;
        document.getElementById('gameOverScreen').style.display = 'flex';
        questionBoxDisplay.style.display = 'none';
        gameUI.style.display = 'none';
    }

    function resetGame() {
        document.getElementById('gameOverScreen').style.display = 'none';
        document.getElementById('menuScreen').style.display = 'flex';
    }

    // --- 6. Main 3D Rendering Loop ---
    function loop() {
        if(state === 'GAMEOVER' || state === 'MENU' || state === 'INTRO') return;

        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        let horizon = canvas.height / 2.2;
        let center = canvas.width / 2;
        let time = Date.now();

        // આકર્ષક આકાશ (Neon Sky)
        let gradSky = ctx.createLinearGradient(0, 0, 0, horizon);
        gradSky.addColorStop(0, "#050515");
        gradSky.addColorStop(1, "#1c1c4a");
        ctx.fillStyle = gradSky; ctx.fillRect(0, 0, canvas.width, horizon);

        // ફ્લોર (Dark Floor)
        ctx.fillStyle = "#050510"; ctx.fillRect(0, horizon, canvas.width, canvas.height);
        
        // નિયોન ગ્રીડ (Neon Grid)
        ctx.save();
        ctx.strokeStyle = "#00e5ff"; ctx.lineWidth = 2;
        ctx.shadowColor = "#00e5ff"; ctx.shadowBlur = 15;
        ctx.globalAlpha = 0.6;
        ctx.beginPath();
        for(let i=-4; i<=4; i+=1.5) {
           let xOffset = i * (canvas.width * 0.2); 
           ctx.moveTo(center + xOffset*0.1, horizon);
           ctx.lineTo(center + xOffset*3, canvas.height);
        }
        let gridOffset = (time * currentSpeed * 0.1) % 100;
        for(let i=0; i<20; i++) {
            let y = horizon + Math.pow(i, 1.8) + gridOffset; // 3D Perspective Grid
            if(y > canvas.height) continue;
            ctx.moveTo(0, y); ctx.lineTo(canvas.width, y);
        }
        ctx.stroke(); ctx.restore();

        // State Logic
        if (state === 'RUNNING') {
            gate.z -= currentSpeed;
            ball.rotation -= currentSpeed * 0.05;
            
            if(gate.z < 250) {
                state = 'STOPPED';
                document.getElementById('btnLeft').innerText = problem.leftIsCorrect ? problem.ans : problem.wrong;
                document.getElementById('btnRight').innerText = problem.leftIsCorrect ? problem.wrong : problem.ans;
                gameUI.style.display = 'flex'; 
            }
        } 
        else if (state === 'STOPPED') {
            currentTime -= 0.1; // ધીમો ટાઈમર
            let bar = document.getElementById('timerBar');
            bar.style.width = currentTime + '%';
            if(currentTime < 30) bar.style.background = 'linear-gradient(90deg, #ff1744, #ff5252)';
            if(currentTime <= 0) gameOver();
        }
        else if (state === 'ANIMATING') {
            ball.x += (ball.targetX - ball.x) * 0.2;
            gate.z -= 15; // દરવાજામાંથી ઝડપથી પસાર થાય
            ball.rotation -= currentSpeed * 0.1;
        }

        // Draw Gates (દરવાજા)
        let scale = 250 / (250 + gate.z);
        let w = canvas.width * 1.5 * scale; if(w > canvas.width) w = canvas.width;
        let h = canvas.height * 1.2 * scale;
        
        if (gate.z > -150 && scale < 5) {
            let lx = center - (w/2); let rx = center + (w/2);
            let pillarW = w * 0.35; let gateY = horizon - h/2;

            ctx.save();
            ctx.shadowColor = "#00ff00"; ctx.shadowBlur = 25;
            ctx.strokeStyle = "#69f0ae"; ctx.lineWidth = 5 * scale;
            ctx.fillStyle = "rgba(0, 255, 100, 0.2)";

            // ડાબો અને જમણો દરવાજો
            ctx.fillRect(lx, gateY, pillarW, h); ctx.strokeRect(lx, gateY, pillarW, h);
            ctx.fillRect(rx - pillarW, gateY, pillarW, h); ctx.strokeRect(rx - pillarW, gateY, pillarW, h);
            
            // Text (જવાબના અંકો)
            ctx.fillStyle = "#ffffff";
            let fontSize = 45 * scale; if(fontSize > 70) fontSize = 70;
            ctx.font = `bold ${fontSize}px Arial`;
            ctx.textAlign = "center"; ctx.textBaseline = "middle";
            ctx.shadowColor = "black"; ctx.shadowBlur = 10;

            let leftNum = problem.leftIsCorrect ? problem.ans : problem.wrong;
            let rightNum = problem.leftIsCorrect ? problem.wrong : problem.ans;
            
            if (gate.z < 1000) { // થોડા નજીક આવે પછી જ અંકો દેખાય
                 ctx.fillText(leftNum, lx + pillarW/2, horizon);
                 ctx.fillText(rightNum, rx - pillarW/2, horizon);
            }
            ctx.restore();
        }

        // Draw Ball (દોડતો બોલ)
        let bounce = Math.sin(time / 150) * 8; 
        let ballYPos = ball.y + bounce;
        
        ctx.save();
        ctx.translate(ball.x, ballYPos);
        ctx.rotate(ball.rotation);
        
        let ballGrad = ctx.createRadialGradient(0, -10, 5, 0, 0, ball.radius);
        ballGrad.addColorStop(0, "#fff");
        ballGrad.addColorStop(0.3, "#00e5ff");
        ballGrad.addColorStop(1, "#2979ff");
        
        ctx.fillStyle = ballGrad;
        ctx.shadowColor = "#00e5ff"; ctx.shadowBlur = 20;
        ctx.beginPath(); ctx.arc(0, 0, ball.radius, 0, Math.PI*2); ctx.fill();
        ctx.shadowBlur = 0;

        ctx.strokeStyle = "rgba(255,255,255,0.8)"; ctx.lineWidth = 4;
        ctx.beginPath(); ctx.arc(0, 0, ball.radius-6, 0.5, 2.5); ctx.stroke();
        ctx.beginPath(); ctx.arc(0, 0, ball.radius-6, 3.5, 5.5); ctx.stroke();
        ctx.restore();
        
        // બોલનો પડછાયો
        ctx.fillStyle = "rgba(0, 229, 255, 0.3)";
        ctx.beginPath();
        ctx.ellipse(ball.x, ball.y + 30, ball.radius * 1.5, ball.radius/2.5, 0, 0, Math.PI*2);
        ctx.fill();

        requestAnimationFrame(loop);
    }
</script>
</body>
</html>
