<script>
// --- AUDIO SYSTEM (Pro Max Sounds without external files) ---
const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

function playTone(freq, type, duration, vol=0.1) {
    if(audioCtx.state === 'suspended') audioCtx.resume();
    let osc = audioCtx.createOscillator();
    let gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
    gain.gain.setValueAtTime(vol, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + duration);
}

function playClick() { playTone(600, 'sine', 0.1, 0.05); }
function playCorrect() { 
    playTone(800, 'triangle', 0.1, 0.1); 
    setTimeout(()=>playTone(1200, 'triangle', 0.2, 0.1), 100); 
}
function playWrong() { playTone(300, 'sawtooth', 0.3, 0.1); }
function playWin() { 
    playTone(523.25, 'sine', 0.2, 0.2); // C5
    setTimeout(()=>playTone(659.25, 'sine', 0.2, 0.2), 150); // E5
    setTimeout(()=>playTone(783.99, 'sine', 0.4, 0.2), 300); // G5
    setTimeout(()=>playTone(1046.50, 'sine', 0.6, 0.2), 450); // C6
}

// --- UI Navigation ---
function showScreen(screenId) {
    document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
    document.getElementById(screenId).classList.add('active');
}

// ફુલસ્ક્રીન અને ઓટોમેટિક લેન્ડસ્કેપ મોડ
async function enterFullscreenMode() {
    let elem = document.getElementById('game-container');
    if (elem.requestFullscreen) await elem.requestFullscreen();
    else if (elem.webkitRequestFullscreen) await elem.webkitRequestFullscreen();
    
    elem.classList.add('fullscreen-mode');
    document.body.classList.add('fullscreen-active');
    
    // મોબાઈલને આડો (Landscape) લોક કરવાનો કોડ
    try {
        if(screen.orientation && screen.orientation.lock) {
            await screen.orientation.lock("landscape");
        }
    } catch (error) {
        console.log("Orientation lock not supported or blocked.");
    }
}

function exitFullscreenMode() {
    if (document.exitFullscreen) document.exitFullscreen();
    else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
    document.getElementById('game-container').classList.remove('fullscreen-mode');
    document.body.classList.remove('fullscreen-active');
    try { if(screen.orientation && screen.orientation.unlock) screen.orientation.unlock(); } catch(e){}
}

document.addEventListener('fullscreenchange', () => {
    if (!document.fullscreenElement) {
        document.getElementById('game-container').classList.remove('fullscreen-mode');
        document.body.classList.remove('fullscreen-active');
    }
});

// --- Generate Standard Buttons ---
const stdGrid = document.getElementById('std-grid');
for (let i = 1; i <= 10; i++) {
    let btn = document.createElement('button');
    btn.className = 'grid-btn'; 
    btn.innerHTML = `ધોરણ ${i}`;
    btn.onclick = () => {
        playClick();
        if(i === 10) showScreen('std10-mode');
        else goToQuestionMode(i, 'dynamic');
    };
    stdGrid.appendChild(btn);
}

// --- Global State ---
let currentGameMode = ''; 
let playingStd = 1;
let currentDBQuestions = [];
let gameActive = false;
let ropePosition = 50;
let questionStyle = 'same'; 

let p1CurrentQ = {};
let p2CurrentQ = {};
let p1Score = 0;
let p2Score = 0;

// --- Flow Logic ---
function goToQuestionMode(std, mode) {
    playingStd = std;
    currentGameMode = mode;
    showScreen('q-mode-select');
}

function startGame(style) {
    if(audioCtx.state === 'suspended') audioCtx.resume(); // Ensure audio plays
    questionStyle = style; 
    initGameArea();
}

// --- DYNAMIC MATH ENGINE ---
function generateMathQuestion(std) {
    let patternsAvailable = [];
    if(std <= 3) patternsAvailable = [0, 1, 2, 4]; 
    else if(std <= 5) patternsAvailable = [0, 1, 2, 3, 4, 11, 12]; 
    else if(std <= 8) patternsAvailable = [2, 3, 5, 6, 7, 9, 10, 13, 14]; 
    else patternsAvailable = [5, 6, 7, 8, 9, 10, 13, 14]; 

    let pattern = patternsAvailable[Math.floor(Math.random() * patternsAvailable.length)];
    let q = "", ans = 0, options = [];
    let numScale = std * 10; 
    let a = Math.floor(Math.random() * numScale) + 1; let b = Math.floor(Math.random() * numScale) + 1; let c = Math.floor(Math.random() * 10) + 2;

    switch(pattern) {
        case 0: q = `${a} + ${b} = ?`; ans = a + b; break;
        case 1: if(a < b) [a, b] = [b, a]; q = `${a} - ${b} = ?`; ans = a - b; break;
        case 2: a = Math.floor(Math.random() * (std * 3)) + 2; b = Math.floor(Math.random() * (std * 2)) + 2; q = `${a} × ${b} = ?`; ans = a * b; break;
        case 3: a = Math.floor(Math.random() * 10) + 2; b = Math.floor(Math.random() * 10) + 2; ans = a; q = `${a * b} ÷ ${b} = ?`; break;
        case 4: ans = b; q = `${a} + ? = ${a + b}`; break;
        case 5: a = Math.floor(Math.random() * 20) + 1; b = Math.floor(Math.random() * 10) + 1; c = Math.floor(Math.random() * 10) + 1; q = `${a} + ${b} × ${c} = ?`; ans = a + (b * c); break;
        case 6: a = Math.floor(Math.random() * 15) + 2; q = `${a} નો વર્ગ (Square)?`; ans = a * a; break;
        case 7: a = Math.floor(Math.random() * 15) + 2; q = `√${a * a} = ?`; ans = a; break;
        case 8: a = Math.floor(Math.random() * 9) + 2; q = `${a} નો ઘન (Cube)?`; ans = a * a * a; break;
        case 9: a = (Math.floor(Math.random() * 9) + 1) * 10; b = (Math.floor(Math.random() * 10) + 1) * 50; q = `${b} ના ${a}% કેટલા?`; ans = (b * a) / 100; break;
        case 10: a = Math.floor(Math.random() * 10) + 2; ans = Math.floor(Math.random() * 15) + 2; q = `જો ${a}x = ${a * ans}, તો x = ?`; break;
        case 11: a = Math.floor(Math.random() * 15) + 2; q = `ચોરસની લંબાઈ ${a}, પરિમિતિ?`; ans = 4 * a; break;
        case 12: a = Math.floor(Math.random() * 15) + 2; b = Math.floor(Math.random() * 10) + 2; q = `લંબચોરસ (લંબાઈ ${a}, પહોળાઈ ${b}) ક્ષેત્રફળ?`; ans = a * b; break;
        case 13: a = Math.floor(Math.random() * 20) + 5; b = Math.floor(Math.random() * 20) + 5; c = Math.floor(Math.random() * 20) + 5; ans = Math.round((a + b + c) / 3); q = `${a}, ${b}, ${c} ની સરેરાશ?`; break;
        case 14: a = Math.floor(Math.random() * 10) + 1; b = Math.floor(Math.random() * 10) + 1; q = `જો x=${a}, y=${b}, તો x²+y = ?`; ans = (a*a) + b; break;
    }

    options.push(ans.toString());
    while(options.length < 4) {
        let wrong = ans + (Math.floor(Math.random() * 20) - 10);
        if(wrong !== ans && !options.includes(wrong.toString()) && wrong >= 0) options.push(wrong.toString());
    }
    options.sort(() => Math.random() - 0.5); 
    return { q: q, options: options, ans: ans.toString() };
}

// --- GITHUB DATABASE LOADER ---
const GITHUB_BASE_URL = "https://cdn.jsdelivr.net/gh/njclassesapp-alt/nj-classes-data@main/";

function loadSubjectDB(fileName, subName) {
    showScreen('loading-screen');
    if(window.njQuestionsDatabase) window.njQuestionsDatabase = null;
    let script = document.createElement('script'); script.src = GITHUB_BASE_URL + fileName;
    script.onload = () => {
        if(window.njQuestionsDatabase && window.njQuestionsDatabase.length > 0) {
            currentDBQuestions = window.njQuestionsDatabase; generateChapterMenu(subName);
        } else { alert("ડેટાબેઝ ખાલી છે!"); showScreen('subject-select'); }
    };
    script.onerror = () => { alert("ઈન્ટરનેટ કનેક્શન તપાસો."); showScreen('subject-select'); };
    document.body.appendChild(script);
}

function generateChapterMenu(subName) {
    document.getElementById('selected-sub-title').innerHTML = `${subName} - ચેપ્ટર પસંદ કરો`;
    let chapterGrid = document.getElementById('chapter-grid'); chapterGrid.innerHTML = '';
    let uniqueChapters = [...new Set(currentDBQuestions.map(item => item.chapter))];

    let btnMix = document.createElement('button'); btnMix.className = 'grid-btn'; btnMix.style.background = 'rgba(255, 65, 108, 0.3)';
    btnMix.innerHTML = "બધા ચેપ્ટર મિક્સ 🔀"; btnMix.onclick = () => { playClick(); prepDbGame("ALL"); }; chapterGrid.appendChild(btnMix);

    uniqueChapters.forEach(ch => {
        let btn = document.createElement('button'); btn.className = 'grid-btn'; btn.innerHTML = `ચેપ્ટર ${ch}`;
        btn.onclick = () => { playClick(); prepDbGame(ch); }; chapterGrid.appendChild(btn);
    });
    showScreen('chapter-select');
}

function prepDbGame(chapter) {
    if(chapter !== "ALL") currentDBQuestions = currentDBQuestions.filter(item => item.chapter == chapter);
    goToQuestionMode(10, 'database');
}

function loadMixDatabase() {
    showScreen('loading-screen');
    let files = ['Std10_Eng_MCQ.js', 'Std10_Hindi_MCQ.js', 'std10-ss-mcq.js', 'std10-sci-mcq.js', 'std10-sanskrit-mcq.js', 'std10-maths-mcq.js', 'std10-guj-mcq.js'];
    currentDBQuestions = []; let loadedCount = 0;
    files.forEach(file => {
        let script = document.createElement('script'); script.src = GITHUB_BASE_URL + file;
        script.onload = () => {
            if(window.njQuestionsDatabase) { currentDBQuestions = currentDBQuestions.concat(window.njQuestionsDatabase); window.njQuestionsDatabase = null; }
            loadedCount++; if(loadedCount === files.length) goToQuestionMode(10, 'database');
        };
        script.onerror = () => { loadedCount++; }; document.body.appendChild(script);
    });
}

// --- TUG OF WAR - ADVANCED ENGINE ---
const knot = document.getElementById('knot');
const qBoxCenter = document.getElementById('qbox-center');
const qBoxP1 = document.getElementById('qbox-p1');
const qBoxP2 = document.getElementById('qbox-p2');
const p1Options = document.getElementById('p1-options');
const p2Options = document.getElementById('p2-options');

function initGameArea() {
    enterFullscreenMode();
    showScreen('game-area');
    ropePosition = 50; p1Score = 0; p2Score = 0;
    document.getElementById('p1-score').innerHTML = 'Score: 0';
    document.getElementById('p2-score').innerHTML = 'Score: 0';
    updateRopeVisual();
    gameActive = true;
    
    if(questionStyle === 'same') {
        qBoxCenter.style.display = 'block'; qBoxP1.style.display = 'none'; qBoxP2.style.display = 'none';
        loadSameQuestion();
    } else {
        qBoxCenter.style.display = 'none'; qBoxP1.style.display = 'block'; qBoxP2.style.display = 'block';
        loadPlayerQuestion(1); loadPlayerQuestion(2);
    }
}

function loadSameQuestion() {
    if (!gameActive) return;
    p1CurrentQ = getNewQuestion(); p2CurrentQ = p1CurrentQ; 
    qBoxCenter.innerHTML = p1CurrentQ.q;
    
    let shuffledOptions = [...p1CurrentQ.options].sort(() => Math.random() - 0.5);
    p1Options.innerHTML = ''; p2Options.innerHTML = '';

    shuffledOptions.forEach(opt => {
        let btn1 = document.createElement('button'); btn1.className = 'opt-btn'; btn1.innerHTML = opt;
        btn1.onclick = () => handleSameAnswer(1, opt); p1Options.appendChild(btn1);

        let btn2 = document.createElement('button'); btn2.className = 'opt-btn'; btn2.innerHTML = opt;
        btn2.onclick = () => handleSameAnswer(2, opt); p2Options.appendChild(btn2);
    });
}

  // માસ્ટર ચેકિંગ ફંક્શન (જવાબમાંથી સ્પેસ અને ટેગ કાઢીને ચોક્કસ મેચ કરશે)
function isAnswerMatch(selected, correct) {
    if (selected == null || correct == null) return false;
    
    function cleanText(text) {
        let temp = document.createElement("div");
        temp.innerHTML = String(text);
        let textContent = temp.textContent || temp.innerText || "";
        return textContent.replace(/\s+/g, '').toLowerCase();
    }

    return cleanText(selected) === cleanText(correct);
}
  
function handleSameAnswer(playerNum, selectedAnswer) {
    if (!gameActive) return;
    
    let targetQ = p1CurrentQ;
    let correctAnsText = "";
    
    // ડેટાબેઝનો જવાબ (નંબર) હોય તો વિકલ્પમાંથી ટેક્સ્ટ લેશે, નહીંતર સીધું ટેક્સ્ટ લેશે
    let ansValue = targetQ.ans !== undefined ? targetQ.ans : targetQ.answer;
    
    if (typeof ansValue === 'number') {
        correctAnsText = targetQ.options[ansValue];
    } else {
        correctAnsText = ansValue;
    }

    let isCorrect = isAnswerMatch(selectedAnswer, correctAnsText);
    
    applyRopePhysics(playerNum, isCorrect);
    if(gameActive) loadSameQuestion(); 
}

function loadPlayerQuestion(playerNum) {
    if (!gameActive) return;
    let newQ = getNewQuestion();
    let optionsBox = playerNum === 1 ? p1Options : p2Options;
    let qBox = playerNum === 1 ? qBoxP1 : qBoxP2;
    
    if(playerNum === 1) p1CurrentQ = newQ; else p2CurrentQ = newQ;
    
    qBox.innerHTML = newQ.q;
    let shuffledOptions = [...newQ.options].sort(() => Math.random() - 0.5);
    optionsBox.innerHTML = '';

    shuffledOptions.forEach(opt => {
        let btn = document.createElement('button'); btn.className = 'opt-btn'; btn.innerHTML = opt;
        btn.onclick = () => handleDiffAnswer(playerNum, opt); optionsBox.appendChild(btn);
    });
}

function handleDiffAnswer(playerNum, selectedAnswer) {
    if (!gameActive) return;
    
    let targetQ = playerNum === 1 ? p1CurrentQ : p2CurrentQ;
    let correctAnsText = "";
    
    // ડેટાબેઝનો જવાબ (નંબર) હોય તો વિકલ્પમાંથી ટેક્સ્ટ લેશે, નહીંતર સીધું ટેક્સ્ટ લેશે
    let ansValue = targetQ.ans !== undefined ? targetQ.ans : targetQ.answer;
    
    if (typeof ansValue === 'number') {
        correctAnsText = targetQ.options[ansValue];
    } else {
        correctAnsText = ansValue;
    }

    let isCorrect = isAnswerMatch(selectedAnswer, correctAnsText);
    
    applyRopePhysics(playerNum, isCorrect);
    if(gameActive) loadPlayerQuestion(playerNum); 
}

function getNewQuestion() {
    if (currentGameMode === 'dynamic') return generateMathQuestion(playingStd);
    else {
        if(currentDBQuestions.length === 0) { endGame("પ્રશ્નો પૂરા થઈ ગયા! ડ્રો!"); return {q:"End", options:[], ans:""}; }
        return currentDBQuestions[Math.floor(Math.random() * currentDBQuestions.length)];
    }
}

function applyRopePhysics(playerNum, isCorrect) {
    let sideElement = document.getElementById(playerNum === 1 ? 'player1-side' : 'player2-side');
    
    if (isCorrect) {
        playCorrect();
        if (playerNum === 1) { ropePosition -= 12; p1Score += 10; }
        if (playerNum === 2) { ropePosition += 12; p2Score += 10; }
        sideElement.classList.add('flash-green');
    } else {
        playWrong();
        if (playerNum === 1) ropePosition += 8;
        if (playerNum === 2) ropePosition -= 8;
        sideElement.classList.add('flash-red');
    }
    
    setTimeout(() => { sideElement.classList.remove('flash-green', 'flash-red'); }, 500);

    document.getElementById('p1-score').innerHTML = 'Score: ' + p1Score;
    document.getElementById('p2-score').innerHTML = 'Score: ' + p2Score;

    let pullEffect = playerNum === 1 ? "translateX(-25px)" : "translateX(25px)";
    document.getElementById('rope').style.transform = `translateY(-50%) ${pullEffect}`;
    setTimeout(() => { document.getElementById('rope').style.transform = `translateY(-50%)`; }, 200);

    updateRopeVisual();
    checkWinCondition();
}

function updateRopeVisual() {
    knot.style.left = ropePosition + "%";
}

function checkWinCondition() {
    if (ropePosition <= 5) endGame("P1 (Blue) Wins! 🎉");
    else if (ropePosition >= 95) endGame("P2 (Red) Wins! 🎉");
}

function endGame(message) {
    gameActive = false;
    playWin();
    document.getElementById('win-text').innerHTML = message;
    showScreen('win-screen');
}
</script>
