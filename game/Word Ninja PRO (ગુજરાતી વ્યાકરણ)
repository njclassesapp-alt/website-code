<!DOCTYPE html>
<html lang="gu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Word Ninja PRO</title>
<style>
    /* 1. Basic Layout */
    body {
        margin: 0; padding: 0;
        overflow-y: auto; overflow-x: hidden;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #0d0d14; color: #fff;
        overscroll-behavior-y: none;
    }

    body.no-scroll-mode {
        overflow: hidden !important;
        touch-action: none !important;
        overscroll-behavior: none !important;
    }

    .blog-content {
        padding: 20px; text-align: center; line-height: 1.6;
    }

    /* Cover Image Styling */
    .game-cover-wrapper {
        width: 100%; max-width: 800px; margin: 0 auto 20px auto;
        border-radius: 15px; overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 242, 254, 0.3);
        border: 2px solid rgba(0, 242, 254, 0.5);
    }
    
    .game-cover-wrapper img {
        width: 100%; height: auto; display: block;
    }

    /* 2. 3D Game Container */
    #game-container {
        position: relative; width: 100%; max-width: 800px; height: 500px;
        margin: 0 auto 30px auto;
        background: radial-gradient(circle at center, #1e1e2f 0%, #05050a 100%);
        border-radius: 20px; overflow: hidden;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.9), inset 0 0 30px rgba(0, 255, 255, 0.15);
        border: 1px solid rgba(255,255,255,0.1);
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    /* Fullscreen API Mode Styling */
    #game-container:fullscreen, 
    #game-container:-webkit-full-screen {
        width: 100vw !important; height: 100vh !important;
        max-width: none !important; margin: 0 !important;
        border-radius: 0 !important; border: none !important;
    }

    /* --- AD BANNER CSS --- */
    #ad-banner-container {
        display: none; /* નોર્મલ મોડમાં છુપાયેલું રહેશે */
        position: absolute; top: 0; left: 0;
        width: 100%; height: 55px;
        background-color: #000;
        z-index: 1000;
        text-align: center;
        justify-content: center; align-items: center;
      overflow: hidden;
    }

    #gameCanvas {
        display: block; width: 100%; height: 100%; touch-action: none;
        position: absolute; top: 0; left: 0;
    }

    /* ફુલ સ્ક્રીન મોડમાં ગેમને 55px નીચે શિફ્ટ કરવા માટે */
    #game-container.fullscreen-mode #ad-banner-container {
        display: flex;
    }
    #game-container.fullscreen-mode #gameCanvas,
    #game-container.fullscreen-mode .ui-layer,
    #game-container.fullscreen-mode #damage-overlay {
        top: 55px !important;
        height: calc(100% - 55px) !important;
      overflow: hidden;
    }

    /* 3. High-End Glassmorphism UI */
    .ui-layer {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        pointer-events: none; display: flex; flex-direction: column;
        justify-content: space-between; padding: 15px; box-sizing: border-box;
    }

    .top-bar {
        display: flex; justify-content: space-between; align-items: center;
        pointer-events: auto; flex-wrap: wrap; gap: 10px;
    }

    .glass-panel {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 8px 18px; border-radius: 12px;
        box-shadow: 0 8px 15px rgba(0, 0, 0, 0.5), inset 0 2px 2px rgba(255, 255, 255, 0.2);
        color: #0ff; font-weight: bold; text-shadow: 0 0 8px #0ff; font-size: 1.1rem;
    }

    .lives-panel { color: #ff416c; text-shadow: 0 0 10px #ff416c; }
    .level-panel { color: #00ffaa; text-shadow: 0 0 10px #00ffaa; }

    /* Target Word 3D Box */
    #target-word-container {
        position: absolute; top: 80px; left: 50%; transform: translateX(-50%);
        pointer-events: none; text-align: center; display: none; width: 100%; z-index: 10;
    }

    .target-box {
        display: inline-block;
        background: linear-gradient(to bottom, #2a2a35, #101016);
        border: 2px solid #ffeb3b;
        box-shadow: 0 10px 20px rgba(0,0,0,0.6), 0 0 20px #ffeb3b, inset 0 0 15px #ffeb3b;
        color: #fff; padding: 12px 30px; border-radius: 40px;
        font-size: 1.6rem; font-weight: 900; letter-spacing: 1px;
    }

    /* 4. 3D Animated Buttons */
    .btn {
        pointer-events: auto; padding: 14px 28px; font-size: 1.2rem;
        font-weight: 900; border: none; border-radius: 50px; cursor: pointer;
        transition: all 0.2s ease; text-transform: uppercase; letter-spacing: 1.5px;
        position: relative; overflow: hidden;
    }

    .btn:active { transform: scale(0.92) translateY(4px); box-shadow: 0 2px 5px rgba(0,0,0,0.5); }

    .btn-play {
        background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
        color: white; border: 2px solid rgba(255,255,255,0.4);
        box-shadow: 0 10px 20px rgba(0, 242, 254, 0.5), inset 0 -4px 0 rgba(0,0,0,0.2);
        text-shadow: 0 2px 4px rgba(0,0,0,0.4);
    }

    /* Ad Button Style */
    .btn-ad {
        background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
        color: #fff; border: 2px solid rgba(255,255,255,0.4);
        box-shadow: 0 10px 20px rgba(253, 160, 133, 0.5), inset 0 -4px 0 rgba(0,0,0,0.2);
        margin-bottom: 15px; font-size: 1rem;
    }

    #exit-btn {
        display: none; background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
        color: white; box-shadow: 0 5px 15px rgba(255, 65, 108, 0.6);
        padding: 10px 20px; font-size: 1rem; border-radius: 10px;
    }

    /* 5. Menus */
    .center-screen {
        position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
        text-align: center; pointer-events: auto; display: flex; flex-direction: column;
        align-items: center; gap: 15px; width: 85%; max-width: 400px;
        background: rgba(15, 15, 25, 0.85); padding: 40px 30px; border-radius: 25px;
        backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px);
        border: 1px solid rgba(255,255,255,0.15);
        box-shadow: 0 20px 50px rgba(0,0,0,0.8), inset 0 0 30px rgba(0, 242, 254, 0.1);
    }

    .title-neon {
        font-size: 2.5rem; color: #fff; margin: 0; font-weight: 900;
        text-shadow: 0 0 10px #0ff, 0 0 20px #0ff, 0 0 40px #0055ff, 0 0 80px #0055ff;
    }

    .subtitle { color: #e0e0e0; font-size: 1.2rem; margin: 0; font-weight: bold; }

    #damage-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: radial-gradient(circle, rgba(255,0,0,0.3) 0%, rgba(255,0,0,0.8) 100%);
        pointer-events: none; opacity: 0; transition: opacity 0.15s ease-out; z-index: 5;
    }

    /* Countdown Text Styling */
    #countdown-text {
        font-size: 6rem; color: #ffeb3b; margin: 0; font-weight: 900;
        text-shadow: 0 0 20px #ffeb3b, 0 0 40px #ff9800;
    }
</style>
