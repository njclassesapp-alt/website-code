<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d', { alpha: false });

// Variables
let width, height;
let gameState = 'INTRO'; // INTRO, PLAYING, GAMEOVER
let score = 0;
let level = 1;
let lives = 3;
let animationId;
let frames = 0;

// Arrays for Game Objects
let activeWords = [];
let particles = [];
let sliceTrail = [];
let isDrawing = false;

// DOM Elements
const gameContainer = document.getElementById('game-container');
const startFullscreenBtn = document.getElementById('start-fullscreen-btn');
const exitBtn = document.getElementById('exit-btn');
const scoreDisplay = document.getElementById('score-display');
const levelDisplay = document.getElementById('level-display');
const livesDisplay = document.getElementById('lives-display');
const targetWordDisplay = document.getElementById('target-word');
const targetContainer = document.getElementById('target-word-container');
const menuScreen = document.getElementById('menu-screen');
const gameOverScreen = document.getElementById('game-over-screen');
const startGameBtn = document.getElementById('start-game-btn');
const restartBtn = document.getElementById('restart-btn');
const watchAdBtn = document.getElementById('watch-ad-btn');
const countdownScreen = document.getElementById('countdown-screen');
const countdownText = document.getElementById('countdown-text');
const finalScoreText = document.getElementById('final-score');
const damageOverlay = document.getElementById('damage-overlay');
const gameCover = document.getElementById('game-cover');

// --- Blogger Text Decoder ---
function decodeHTML(html) {
    const txt = document.createElement("textarea");
    txt.innerHTML = html;
    return txt.value;
}

// --- Game Data (Levels & Words) ---
const gameData = [
    { target: "સૂર્ય", correct: ["રવિ", "ભાનુ", "દિનકર", "ભાસ્કર"], wrong: ["ચંદ્ર", "રાત્રિ", "તારો", "વાદળ"] },
    { target: "પાણી", correct: ["જળ", "નીર", "વારિ", "સલિલ"], wrong: ["અગ્નિ", "આગ", "પવન", "માટી"] },
    { target: "આકાશ", correct: ["ગગન", "નભ", "આભ", "વ્યોમ"], wrong: ["ધરતી", "જમીન", "પાતાળ", "ખડક"] }
    // મેં અહીં ડેટા ટૂંકાવ્યો છે, તમે તમારો સંપૂર્ણ ડેટા અહીં મૂકી દેજો.
];
let currentLevelData;

function getRandomLevelData() {
    return gameData[Math.floor(Math.random() * gameData.length)];
}

// --- Web Audio API ---
const AudioContext = window.AudioContext || window.webkitAudioContext;
let audioCtx;

function initAudio() {
    if (!audioCtx) audioCtx = new AudioContext();
    if (audioCtx.state === 'suspended') audioCtx.resume();
}

function playSound(type) {
    if (!audioCtx) return;
    const osc = audioCtx.createOscillator();
    const gainNode = audioCtx.createGain();
    osc.connect(gainNode);
    gainNode.connect(audioCtx.destination);
    const now = audioCtx.currentTime;
    
    if (type === 'throw') {
        osc.type = 'sine'; osc.frequency.setValueAtTime(200, now); osc.frequency.exponentialRampToValueAtTime(400, now + 0.2);
        gainNode.gain.setValueAtTime(0.1, now); gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
        osc.start(now); osc.stop(now + 0.2);
    } else if (type === 'slice_correct') {
        osc.type = 'triangle'; osc.frequency.setValueAtTime(800, now); osc.frequency.exponentialRampToValueAtTime(1500, now + 0.1);
        gainNode.gain.setValueAtTime(0.4, now); gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.2);
        osc.start(now); osc.stop(now + 0.2);
    } else if (type === 'bomb' || type === 'slice_wrong') {
        osc.type = 'sawtooth'; osc.frequency.setValueAtTime(100, now); osc.frequency.exponentialRampToValueAtTime(10, now + 0.5);
        gainNode.gain.setValueAtTime(0.7, now); gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.5);
        osc.start(now); osc.stop(now + 0.5);
    } else if (type === 'level_up') {
        osc.type = 'square'; osc.frequency.setValueAtTime(440, now); osc.frequency.setValueAtTime(554.37, now + 0.1); osc.frequency.setValueAtTime(659.25, now + 0.2);
        gainNode.gain.setValueAtTime(0.3, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.6);
        osc.start(now); osc.stop(now + 0.6);
    }
}

// --- Classes ---
class WordObj {
    constructor() {
        this.radius = Math.min(width, height) * 0.09; 
        this.x = Math.random() * (width - this.radius * 2) + this.radius;
        this.y = height + this.radius; 
        this.vx = (Math.random() - 0.5) * 2; 
        this.vy = -(Math.random() * 2.5 + 6.5 + (level * 0.1)); 
        this.gravity = 0.06; 
        this.rotation = Math.random() * Math.PI * 2;
        this.rotSpeed = (Math.random() - 0.5) * 0.02;
        this.markedForDeletion = false;

        this.isCorrect = Math.random() > 0.4; 
        let rawText = "";
        if (this.isCorrect) {
            rawText = currentLevelData.correct[Math.floor(Math.random() * currentLevelData.correct.length)];
            this.baseColor = '#00ffaa'; 
            this.darkColor = '#004422';
        } else {
            rawText = currentLevelData.wrong[Math.floor(Math.random() * currentLevelData.wrong.length)];
            this.baseColor = '#ff4b2b'; 
            this.darkColor = '#440000';
        }
        this.text = decodeHTML(rawText);
    }

    update() {
        this.x += this.vx; this.y += this.vy; this.vy += this.gravity; this.rotation += this.rotSpeed;
        if (this.x - this.radius < 0 || this.x + this.radius > width) this.vx *= -1;
        if (this.y - this.radius > height && this.vy > 0) {
            this.markedForDeletion = true;
            if (this.isCorrect && gameState === 'PLAYING') takeDamage();
        }
    }

    draw() {
        ctx.save(); ctx.translate(this.x, this.y); ctx.rotate(this.rotation);
        const gradient = ctx.createRadialGradient(-this.radius/3, -this.radius/3, this.radius/10, 0, 0, this.radius);
        gradient.addColorStop(0, '#ffffff'); gradient.addColorStop(0.3, this.baseColor); gradient.addColorStop(1, this.darkColor); 
        ctx.shadowBlur = 20; ctx.shadowColor = this.baseColor; ctx.fillStyle = gradient;
        ctx.beginPath(); ctx.arc(0, 0, this.radius, 0, Math.PI * 2); ctx.fill();
        ctx.strokeStyle = 'rgba(255,255,255,0.4)'; ctx.lineWidth = 2; ctx.stroke();
        ctx.shadowBlur = 5; ctx.shadowColor = '#000000'; ctx.fillStyle = '#ffffff';
        ctx.font = `900 ${this.radius * 0.45}px 'Segoe UI', sans-serif`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.strokeStyle = '#000'; ctx.lineWidth = 3; ctx.strokeText(this.text, 0, 0); ctx.fillText(this.text, 0, 0);
        ctx.restore();
    }
}

class Particle {
    constructor(x, y, color) {
        this.x = x; this.y = y; this.vx = (Math.random() - 0.5) * 10; this.vy = (Math.random() - 0.5) * 10;
        this.size = Math.random() * 6 + 2; this.color = color; this.life = 1; this.decay = Math.random() * 0.03 + 0.02;
    }
    update() { this.x += this.vx; this.y += this.vy; this.life -= this.decay; }
    draw() {
        ctx.globalAlpha = this.life; ctx.fillStyle = this.color; ctx.shadowBlur = 10; ctx.shadowColor = this.color;
        ctx.beginPath(); ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2); ctx.fill();
        ctx.globalAlpha = 1.0; ctx.shadowBlur = 0;
    }
}

// --- Game Functions ---
function resizeCanvas() {
    width = gameContainer.clientWidth;
    height = gameContainer.clientHeight;
    // જો ફુલસ્ક્રીન હોય, તો કેનવાસની ઊંચાઈ 55px ઓછી કરીશું 
    if (gameContainer.classList.contains('fullscreen-mode')) {
        height = height - 55;
    }
    canvas.width = width;
    canvas.height = height;
}

function updateUI() {
    scoreDisplay.innerText = `Score: ${score}`;
    levelDisplay.innerText = `Level: ${level}`;
    const hearts = '❤️'.repeat(Math.max(0, lives));
    livesDisplay.innerText = decodeHTML(hearts);
    if(currentLevelData) targetWordDisplay.innerText = decodeHTML(currentLevelData.target);
}

function createExplosion(x, y, color) {
    for (let i = 0; i < 20; i++) particles.push(new Particle(x, y, color));
}

function takeDamage() {
    lives--; updateUI(); playSound('bomb');
    damageOverlay.style.opacity = '1';
    setTimeout(() => { damageOverlay.style.opacity = '0'; }, 150);
    if (lives <= 0) gameOver();
}

function checkLevelUp() {
    let nextLevelReq = level * 50; 
    if (score >= nextLevelReq) {
        level++; currentLevelData = getRandomLevelData(); playSound('level_up'); updateUI();
        damageOverlay.style.background = 'radial-gradient(circle, rgba(0,255,170,0.3) 0%, rgba(0,255,170,0.8) 100%)';
        damageOverlay.style.opacity = '1';
        setTimeout(() => { 
            damageOverlay.style.opacity = '0'; 
            setTimeout(() => { damageOverlay.style.background = 'radial-gradient(circle, rgba(255,0,0,0.3) 0%, rgba(255,0,0,0.8) 100%)'; }, 200);
        }, 300);
    }
}

function getCanvasPos(evt) {
    const rect = canvas.getBoundingClientRect();
    const clientX = evt.touches ? evt.touches[0].clientX : evt.clientX;
    const clientY = evt.touches ? evt.touches[0].clientY : evt.clientY;
    return { x: clientX - rect.left, y: clientY - rect.top };
}

function blockScroll(e) {
    if (document.fullscreenElement || document.body.classList.contains('no-scroll-mode')) {
        if (e.cancelable) e.preventDefault();
    }
}
gameContainer.addEventListener('touchmove', blockScroll, {passive: false});

function handleStart(e) {
    if (gameState !== 'PLAYING') return;
    blockScroll(e); isDrawing = true; sliceTrail = [getCanvasPos(e)];
}

function handleMove(e) {
    if (!isDrawing || gameState !== 'PLAYING') return;
    blockScroll(e); const pos = getCanvasPos(e); sliceTrail.push(pos);
    if (sliceTrail.length > 12) sliceTrail.shift(); 
    activeWords.forEach(word => {
        if (word.markedForDeletion) return;
        const dx = pos.x - word.x; const dy = pos.y - word.y;
        if (Math.sqrt(dx * dx + dy * dy) < word.radius) {
            word.markedForDeletion = true;
            if (word.isCorrect) {
                score += 10; playSound('slice_correct'); createExplosion(word.x, word.y, '#00ffaa'); checkLevelUp(); updateUI();
            } else {
                createExplosion(word.x, word.y, '#ff4b2b'); takeDamage();
            }
        }
    });
}
function handleEnd() { isDrawing = false; sliceTrail = []; }

canvas.addEventListener('touchstart', handleStart, {passive: false});
canvas.addEventListener('touchmove', handleMove, {passive: false});
canvas.addEventListener('touchend', handleEnd);
canvas.addEventListener('mousedown', handleStart);
canvas.addEventListener('mousemove', handleMove);
canvas.addEventListener('mouseup', handleEnd);
canvas.addEventListener('mouseleave', handleEnd);

function drawBackground() {
    const gradient = ctx.createRadialGradient(width/2, height/2, 10, width/2, height/2, width);
    gradient.addColorStop(0, '#1a1a2e'); gradient.addColorStop(1, '#05050a'); ctx.fillStyle = gradient; ctx.fillRect(0, 0, width, height);
    ctx.strokeStyle = 'rgba(0, 242, 254, 0.05)'; ctx.lineWidth = 1; ctx.beginPath();
    for(let i=0; i<width; i+=50) { ctx.moveTo(i, 0); ctx.lineTo(i, height); }
    for(let j=0; j<height; j+=50) { ctx.moveTo(0, j); ctx.lineTo(width, j); }
    ctx.stroke();
}

function drawSliceTrail() {
    if (sliceTrail.length < 2) return;
    ctx.beginPath(); ctx.moveTo(sliceTrail[0].x, sliceTrail[0].y);
    for (let i = 1; i < sliceTrail.length; i++) { ctx.lineTo(sliceTrail[i].x, sliceTrail[i].y); }
    ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.lineWidth = 6; ctx.strokeStyle = '#ffffff';
    ctx.shadowBlur = 20; ctx.shadowColor = '#00f2fe'; ctx.stroke();
    ctx.lineWidth = 2; ctx.strokeStyle = '#00f2fe'; ctx.stroke(); ctx.shadowBlur = 0; 
}

function gameLoop() {
    if (gameState !== 'PLAYING') return;
    drawBackground(); frames++;
    let spawnRate = Math.max(60, 120 - (level * 6)); 
    if (frames % spawnRate === 0) { activeWords.push(new WordObj()); playSound('throw'); }
    activeWords.forEach(word => { word.update(); word.draw(); });
    activeWords = activeWords.filter(w => !w.markedForDeletion);
    particles.forEach(p => { p.update(); p.draw(); });
    particles = particles.filter(p => p.life > 0);
    drawSliceTrail();
    animationId = requestAnimationFrame(gameLoop);
}

// --- State Management ---
function startGame() {
    initAudio(); gameState = 'PLAYING'; score = 0; level = 1; lives = 3; frames = 0; activeWords = []; particles = [];
    currentLevelData = getRandomLevelData(); 
    if(gameCover) gameCover.style.display = 'none'; 
    menuScreen.style.display = 'none'; gameOverScreen.style.display = 'none'; targetContainer.style.display = 'block';
    updateUI(); gameLoop();
}

function gameOver() {
    gameState = 'GAMEOVER'; cancelAnimationFrame(animationId);
    targetContainer.style.display = 'none'; gameOverScreen.style.display = 'flex';
    finalScoreText.innerText = `Final Score: ${score}`;
}

function resetToMenu() {
    gameState = 'INTRO'; cancelAnimationFrame(animationId); activeWords = []; ctx.clearRect(0, 0, width, height); drawBackground();
    if(gameCover) gameCover.style.display = 'block'; 
    menuScreen.style.display = 'flex'; gameOverScreen.style.display = 'none'; targetContainer.style.display = 'none';
    currentLevelData = getRandomLevelData(); updateUI();
}

// --- REWARDED AD LOGIC ---

// 1. બટન પર ક્લિક થાય ત્યારે Android એપને સિગ્નલ મોકલવું
window.onRewardedAdWatched = function() {
    enterFullscreenMode(); // સ્ક્રીન પાછી ફૂલ કરી દેશે
    gameOverScreen.style.display = 'none'; 
    
    startCountdown(() => {
        lives = 3; 
        updateUI();
        gameState = 'PLAYING';
        targetContainer.style.display = 'block';
        
        // જૂના શબ્દો સાફ કરવા જેથી ગેમ ફરીથી સ્મૂથ ચાલુ થાય
        activeWords = []; 
        particles = [];
        
        gameLoop(); 
    });
};

// 2. આ ફંક્શન Android એપમાંથી એડ પૂરી થયા પછી બોલાવવામાં આવશે
window.onRewardedAdWatched = function() {
    gameOverScreen.style.display = 'none'; // ગેમ ઓવર સ્ક્રીન છુપાવો
    startCountdown(() => {
        // કાઉન્ટડાઉન પૂરું થયા પછી ગેમ શરૂ કરો
        lives = 3; // યુઝરને ફરીથી 3 લાઈફ આપો (અથવા તમે 1 પણ રાખી શકો)
        updateUI();
        gameState = 'PLAYING';
        targetContainer.style.display = 'block';
        gameLoop(); // ગેમ જ્યાંથી અટકી હતી ત્યાંથી જ ચાલુ થશે
    });
};

function startCountdown(callback) {
    countdownScreen.style.display = 'flex';
    let count = 3;
    countdownText.innerText = count;
    playSound('throw');

    let interval = setInterval(() => {
        count--;
        if (count > 0) {
            countdownText.innerText = count;
            playSound('throw');
        } else if (count === 0) {
            countdownText.innerText = "GO!";
            playSound('level_up');
        } else {
            clearInterval(interval);
            countdownScreen.style.display = 'none';
            callback();
        }
    }, 1000);
}

// --- Fullscreen API Setup ---
function openFullscreen() {
    if (gameContainer.requestFullscreen) { gameContainer.requestFullscreen(); }
    else if (gameContainer.webkitRequestFullscreen) { gameContainer.webkitRequestFullscreen(); }
    else if (gameContainer.msRequestFullscreen) { gameContainer.msRequestFullscreen(); }
}

function closeFullscreen() {
    if (document.fullscreenElement || document.webkitFullscreenElement) {
        if (document.exitFullscreen) { document.exitFullscreen(); }
        else if (document.webkitExitFullscreen) { document.webkitExitFullscreen(); }
    }
}

function enterFullscreenMode() {
    openFullscreen();
    document.body.classList.add('no-scroll-mode');
    gameContainer.classList.add('fullscreen-mode');
    exitBtn.style.display = 'block';
    setTimeout(resizeCanvas, 200);
}

document.addEventListener('fullscreenchange', handleFullscreenChange);
document.addEventListener('webkitfullscreenchange', handleFullscreenChange);

function handleFullscreenChange() {
    if (!document.fullscreenElement && !document.webkitFullscreenElement) {
        document.body.classList.remove('no-scroll-mode');
        gameContainer.classList.remove('fullscreen-mode');
        exitBtn.style.display = 'none';
        resizeCanvas();
        
        // જો યુઝર ખરેખર રમી રહ્યો હોય તો જ ગેમ ઓવર થાય, એડ જોતી વખતે નહીં!
        if (gameState === 'PLAYING') {
            gameOver(); 
        }
    }
}

window.addEventListener('resize', resizeCanvas);

// બંને બટનમાં Fullscreen ફંક્શન ઉમેર્યું 
startFullscreenBtn.addEventListener('click', () => {
    initAudio();
    enterFullscreenMode();
    window.scrollTo(0, 0); 
    if(gameState === 'INTRO') resetToMenu();
});

startGameBtn.addEventListener('click', () => {
    initAudio();
    enterFullscreenMode(); // હવે આ બટનથી પણ ફુલ સ્ક્રીન થશે
    startGame();
});

exitBtn.addEventListener('click', () => { closeFullscreen(); });
restartBtn.addEventListener('click', startGame);

resizeCanvas(); resetToMenu();
</script>

