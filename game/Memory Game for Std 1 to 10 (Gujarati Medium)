  <span><!--more--></span>
<div id="gameWrapper">
    <div id="topBar">
        <div class="stats-badge">Lvl: <span id="levelDisplay">1</span> | 🔄 <span id="movesDisplay">0</span></div>
        <button id="exitBtn" class="exit-btn" onclick="exitFullscreen()">Exit ❌</button>
    </div>

    <div id="introScreen" class="screen">
        <h1>🧠 મેમરી પાવર 3D</h1>
        <div class="intro-box">
            <h3 style="color:var(--accent); margin:0 0 10px 0;">🎮 નિયમો:</h3>
            <ul style="margin:0; padding-left:20px; color:#ddd; font-size:15px; line-height:1.5;">
                <li>બે કાર્ડ ખોલો અને જોડી બનાવો.</li>
                <li>જેમ લેવલ પાર કરશો, ગેમ અઘરી થશે!</li>
                <li>ઓછી ચાલમાં પૂરું કરો.</li>
            </ul>
        </div>
        <button class="btn-3d" onclick="openFullscreenAndStart()">Play Now ▶️</button>
    </div>

    <div id="levelUpScreen" class="screen" style="display: none;">
        <h1>🎉 Excellent! 🎉</h1>
        <div class="level-text">Level <span id="completedLevel">1</span> Completed!</div>
        <div class="intro-box" style="text-align:center;">
            <p><strong>ચાલ (Moves):</strong> <span id="finalMoves">0</span></p>
            <p style="color:#aaa; font-size:14px;">હવે તૈયાર થઈ જાઓ અઘરા લેવલ માટે!</p>
        </div>
        <button class="btn-3d" onclick="startNextLevel()">Next Level 🚀</button>
    </div>

    <div id="winScreen" class="screen" style="display: none;">
        <h1 style="color: #00e676;">🏆 YOU ARE A GENIUS!</h1>
        <p>તમે બધા લેવલ પાર કરી લીધા છે!</p>
        <button class="btn-3d" onclick="resetFullGame()">ફરીથી રમો 🔄</button>
    </div>

    <div id="gameArea" style="display: none;">
        <div class="grid-container" id="gridContainer"></div>
    </div>
</div>
<script>
    const wrapper = document.getElementById('gameWrapper');
    const exitBtn = document.getElementById('exitBtn');
    const gridContainer = document.getElementById('gridContainer');
    const introScreen = document.getElementById('introScreen');
    const levelUpScreen = document.getElementById('levelUpScreen');
    const winScreen = document.getElementById('winScreen');
    const gameArea = document.getElementById('gameArea');
    const levelDisplay = document.getElementById('levelDisplay');
    const movesDisplay = document.getElementById('movesDisplay');

    // બહુ બધા Emojis નો ડેટાબેઝ
    const allEmojis = ['🐶','🐱','🐭','🐹','🐰','🦊','🐻','🐼','🐨','🐯','🦁','🐮','🐷','🐸','🐵','🐔','🐧','🐦','🐤','🦆','🦅','🦉','🦇','🐺','🐗','🐴','🦄','🐝','🐛','🦋','🐌','🐞','🐜','🦟','🐢','🐍','🦎','🦖','🦕','🐙','🦑','🦐','🦞','🦀','🐡','🐠','🐟','🐬','🐳','🐋','🦈','🐊','🐅','🐆','🦓','🦍','🦧','🐘','🦛','🦏','🐪','🐫','🦒','🦘','🐃','🐂','🐄','🐎','🐖','🐏','🐑','🦙','🐐','🦌','🐕','🐩','🦮','🐕‍🦺','🐈','🐓','🦃','🦚','🦜','🦢','🦩','🕊️','🐇','🦝','🦨','🦡','🦦','🦥','🐁','🐀','🐿️','🦔'];

    let level = 1;
    let maxLevel = 10;
    let moves = 0;
    let matchedPairs = 0;
    let totalPairs = 0;
    let flippedCards = [];
    let isLocked = false;

    // --- Audio System ---
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    let audioCtx;
    
    function initAudio() {
        if (!audioCtx) audioCtx = new AudioContext();
        if (audioCtx.state === 'suspended') audioCtx.resume();
    }

    function playSound(type) {
        if (!audioCtx) return;
        const osc = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();
        osc.connect(gainNode);
        gainNode.connect(audioCtx.destination);
        const now = audioCtx.currentTime;

        if (type === 'flip') {
            osc.type = 'sine'; osc.frequency.setValueAtTime(400, now);
            osc.frequency.exponentialRampToValueAtTime(800, now + 0.1);
            gainNode.gain.setValueAtTime(0.2, now); gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
            osc.start(now); osc.stop(now + 0.1);
        } else if (type === 'match') {
            osc.type = 'triangle'; osc.frequency.setValueAtTime(400, now);
            osc.frequency.setValueAtTime(600, now + 0.1); osc.frequency.setValueAtTime(800, now + 0.2);
            gainNode.gain.setValueAtTime(0.2, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.4);
            osc.start(now); osc.stop(now + 0.4);
        } else if (type === 'error') {
            osc.type = 'sawtooth'; osc.frequency.setValueAtTime(200, now);
            osc.frequency.linearRampToValueAtTime(100, now + 0.3);
            gainNode.gain.setValueAtTime(0.2, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.3);
            osc.start(now); osc.stop(now + 0.3);
        } else if (type === 'win') {
            osc.type = 'square'; osc.frequency.setValueAtTime(300, now);
            osc.frequency.linearRampToValueAtTime(900, now + 0.5);
            gainNode.gain.setValueAtTime(0.2, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.5);
            osc.start(now); osc.stop(now + 0.5);
        }
    }

    // --- Pseudo-Fullscreen (Keep Status Bar) ---
    function openFullscreenAndStart() {
        initAudio();
        wrapper.classList.add('fullscreen-mode');
        document.body.style.overflow = 'hidden'; // પોસ્ટનું સ્ક્રોલ બંધ કરો
        exitBtn.style.display = 'block';
        
        introScreen.style.display = 'none';
        startGame();
    }

    function exitFullscreen() {
        wrapper.classList.remove('fullscreen-mode');
        document.body.style.overflow = 'auto'; // પોસ્ટનું સ્ક્રોલ ચાલુ કરો
        exitBtn.style.display = 'none';
        
        // Reset everything to intro
        gameArea.style.display = 'none';
        levelUpScreen.style.display = 'none';
        winScreen.style.display = 'none';
        introScreen.style.display = 'flex';
        level = 1;
    }

    // --- Game Logic ---
    function startGame() {
        moves = 0;
        matchedPairs = 0;
        flippedCards = [];
        isLocked = false;
        
        movesDisplay.innerText = moves;
        levelDisplay.innerText = level;
        
        gameArea.style.display = 'flex';
        setupGrid();
    }

    function startNextLevel() {
        levelUpScreen.style.display = 'none';
        level++;
        startGame();
    }

    function resetFullGame() {
        winScreen.style.display = 'none';
        level = 1;
        startGame();
    }

    function setupGrid() {
        gridContainer.innerHTML = '';
        
        // લેવલ મુજબ કાર્ડની સંખ્યા વધશે (લેવલ 1 = 4 જોડી, લેવલ 2 = 6 જોડી...)
        totalPairs = 3 + level; 
        if (totalPairs > 18) totalPairs = 18; // Max 36 cards
        
        // Random Emojis સિલેક્ટ કરો
        let shuffledEmojis = [...allEmojis].sort(() => 0.5 - Math.random());
        let selectedEmojis = shuffledEmojis.slice(0, totalPairs);
        
        // ડબલ કરો અને મિક્સ કરો
        let cardsArray = [...selectedEmojis, ...selectedEmojis].sort(() => 0.5 - Math.random());
        
        // Grid Columns નક્કી કરો (મોબાઈલમાં સારી રીતે દેખાય તે માટે)
        let cols = 4;
        if (cardsArray.length > 16) cols = 5;
        if (cardsArray.length > 25) cols = 6;
        gridContainer.style.gridTemplateColumns = `repeat(${cols}, 1fr)`;

        // HTML માં કાર્ડ બનાવો
        cardsArray.forEach((icon, index) => {
            const card = document.createElement('div');
            card.classList.add('card');
            card.dataset.icon = icon;
            
            card.innerHTML = `
                <div class="card-inner">
                    <div class="card-front">?</div>
                    <div class="card-back">${icon}</div>
                </div>
            `;
            
            card.addEventListener('click', () => flipCard(card));
            gridContainer.appendChild(card);
        });
    }

    function flipCard(card) {
        if (isLocked) return;
        if (card.classList.contains('flipped') || card.classList.contains('matched')) return;

        playSound('flip');
        card.classList.add('flipped');
        flippedCards.push(card);

        if (flippedCards.length === 2) {
            moves++;
            movesDisplay.innerText = moves;
            checkForMatch();
        }
    }

    function checkForMatch() {
        let card1 = flippedCards[0];
        let card2 = flippedCards[1];

        if (card1.dataset.icon === card2.dataset.icon) {
            // Match Found!
            playSound('match');
            card1.classList.add('matched');
            card2.classList.add('matched');
            matchedPairs++;
            flippedCards = [];

            if (matchedPairs === totalPairs) {
                setTimeout(endLevel, 800);
            }
        } else {
            // No Match
            isLocked = true;
            playSound('error');
            setTimeout(() => {
                card1.classList.remove('flipped');
                card2.classList.remove('flipped');
                flippedCards = [];
                isLocked = false;
            }, 1000); // 1 સેકન્ડ પછી પાછા ફરશે
        }
    }

    function endLevel() {
        playSound('win');
        gameArea.style.display = 'none';
        
        if (level >= maxLevel) {
            winScreen.style.display = 'flex';
        } else {
            document.getElementById('completedLevel').innerText = level;
            document.getElementById('finalMoves').innerText = moves;
            levelUpScreen.style.display = 'flex';
        }
    }

</script>
</body>
