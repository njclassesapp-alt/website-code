<!DOCTYPE html>
<html lang="gu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>3D Memory Trainer Pro</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Hind+Vadodara:wght@600;800&display=swap');

        :root {
            --primary: #4a148c;
            --secondary: #7c43bd;
            --accent: #00e5ff;
            --bg-dark: #12122a;
            --success: #00e676;
        }

        body, html {
            margin: 0; padding: 0; width: 100%;
            background-color: var(--bg-dark);
            font-family: 'Hind Vadodara', sans-serif;
            overflow-y: auto; /* Allow scrolling on main page */
        }

        /* --- 3D Game Container --- */
        #gameWrapper {
            position: relative;
            width: 100%; max-width: 600px;
            height: 80vh; min-height: 500px; max-height: 700px;
            margin: 20px auto;
            background: radial-gradient(circle at top, #2a2a4a, #0a0a1a);
            border-radius: 20px;
            border: 4px solid var(--accent);
            box-shadow: 0 15px 35px rgba(0, 229, 255, 0.3), inset 0 0 20px rgba(0,0,0,0.8);
            overflow: hidden;
            perspective: 1000px;
        }

        /* --- Pseudo-Fullscreen (Keep Status Bar) --- */
        .fullscreen-mode {
            position: fixed !important;
            top: 0 !important; left: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            height: 100dvh !important;
            z-index: 99999 !important;
            margin: 0 !important;
            border-radius: 0 !important;
            border: none !important;
        }

        /* --- Screens --- */
        .screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            background: rgba(10, 10, 26, 0.95);
            color: white; text-align: center;
            z-index: 100;
            padding: 20px; box-sizing: border-box;
            transition: opacity 0.4s ease;
            overflow-y: auto;
        }

        h1 {
            color: var(--accent);
            font-size: 32px; font-weight: 800;
            text-shadow: 0 0 15px rgba(0, 229, 255, 0.6);
            margin-bottom: 20px;
        }

        /* --- Top Bar --- */
        #topBar {
            position: absolute; top: 0; left: 0; width: 100%;
            padding: 15px 20px; box-sizing: border-box;
            display: flex; justify-content: space-between; align-items: center;
            background: linear-gradient(to bottom, rgba(0,0,0,0.8), transparent);
            z-index: 50;
        }

        .stats-badge {
            background: rgba(255,255,255,0.1);
            border: 1px solid var(--accent);
            padding: 8px 15px; border-radius: 20px;
            color: var(--accent); font-weight: bold; font-size: 16px;
            box-shadow: 0 0 10px rgba(0,229,255,0.2);
        }

        .exit-btn {
            background: #ff1744; color: white; border: none;
            padding: 8px 15px; border-radius: 20px; font-weight: bold;
            cursor: pointer; display: none;
            box-shadow: 0 0 10px rgba(255, 23, 68, 0.5);
        }

        /* --- Buttons --- */
        .btn-3d {
            background: linear-gradient(145deg, var(--secondary), var(--primary));
            color: white; border: none;
            padding: 15px 40px; font-size: 22px; font-weight: bold;
            border-radius: 50px; cursor: pointer;
            box-shadow: 0 10px 20px rgba(0,0,0,0.5), inset 0 2px 5px rgba(255,255,255,0.3);
            transition: all 0.2s; margin-top: 20px;
            border: 2px solid #b388ff;
        }
        .btn-3d:active {
            transform: translateY(5px);
            box-shadow: 0 5px 10px rgba(0,0,0,0.5), inset 0 2px 5px rgba(255,255,255,0.1);
        }

        /* --- 3D Grid & Cards --- */
        #gameArea {
            position: absolute; top: 70px; left: 0; width: 100%; height: calc(100% - 70px);
            display: flex; justify-content: center; align-items: center; padding: 10px; box-sizing: border-box;
        }

        .grid-container {
            display: grid; gap: 10px; width: 100%; max-width: 500px;
            justify-content: center; align-content: center;
            perspective: 1000px;
        }

        .card {
            background-color: transparent; aspect-ratio: 1 / 1;
            cursor: pointer; -webkit-tap-highlight-color: transparent;
        }

        .card-inner {
            position: relative; width: 100%; height: 100%;
            text-align: center; transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
            transform-style: preserve-3d;
        }

        .card.flipped .card-inner { transform: rotateY(180deg); }
        .card.matched .card-inner {
            transform: rotateY(180deg) scale(0.95);
            animation: glowPulse 1.5s infinite alternate;
        }

        @keyframes glowPulse {
            from { box-shadow: 0 0 10px var(--success), inset 0 0 20px rgba(0,230,118,0.5); }
            to { box-shadow: 0 0 25px var(--success), inset 0 0 40px rgba(0,230,118,0.8); }
        }

        .card-front, .card-back {
            position: absolute; width: 100%; height: 100%;
            -webkit-backface-visibility: hidden; backface-visibility: hidden;
            border-radius: 15px; display: flex; justify-content: center; align-items: center;
            box-shadow: 0 8px 15px rgba(0,0,0,0.4);
        }

        /* 3D Front (Question Mark) */
        .card-front {
            background: linear-gradient(135deg, #311b92, #512da8);
            border: 2px solid #7c43bd; color: rgba(255,255,255,0.5); font-size: 30px;
            transform: translateZ(5px);
        }

        /* 3D Back (Emoji) */
        .card-back {
            background: linear-gradient(135deg, #ffffff, #e0e0e0);
            transform: rotateY(180deg) translateZ(5px);
            font-size: 35px; border: 3px solid var(--accent);
        }

        /* Intro Info */
        .intro-box {
            background: rgba(255,255,255,0.05); padding: 15px; border-radius: 15px;
            border-left: 4px solid var(--accent); text-align: left; width: 90%; max-width: 400px;
            margin-bottom: 15px;
        }
        .intro-img { width: 100%; max-width: 250px; border-radius: 15px; border: 2px solid var(--accent); margin-bottom: 15px;}
        
        .level-text { font-size: 24px; color: #ffd740; font-weight: bold; margin-bottom: 10px;}

    </style>
</head>
<body>

