        display: flex; flex-direction: column; align-items: center; justify-content: center;
        cursor: pointer; position: relative; transition: transform 0.1s;
    }
    .elem-btn:active { transform: scale(0.9); }
    .elem-name { font-size: 11px; color: #ccc; margin-top: 2px; }

    /* MIX IT બટનનું એનિમેશન અલગ કર્યું */
    #mixBtn {
        position: absolute; bottom: 155px; left: 50%; transform: translateX(-50%);
        padding: 12px 50px; border-radius: 50px; background: linear-gradient(90deg, #00d2ff, #3a7bd5);
