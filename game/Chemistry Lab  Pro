        { elements: ['C', 'C', 'H', 'H', 'H', 'H', 'H', 'H'], result: 'C₂H₆', name: 'Ethane', desc: 'ઇંધણ ગેસ! ⛽' },
        { elements: ['C', 'C', 'H', 'H', 'H', 'H'], result: 'C₂H₄', name: 'Ethylene', desc: 'પ્લાસ્ટિક બનાવવા માટે! 🛍️' },
        { elements: ['C', 'C', 'H', 'H'], result: 'C₂H₂', name: 'Acetylene', desc: 'વેલ્ડિંગ માટે વપરાય! 👨‍🏭' },
        { elements: ['H', 'C', 'N'], result: 'HCN',  name: 'Hydrogen Cyanide', desc: 'ખૂબ જ ખતરનાક ઝેર! ☠️' },
        { elements: ['C', 'S', 'S'], result: 'CS₂',  name: 'Carbon Disulfide', desc: 'દુર્ગંધ મારતું પ્રવાહી! 🤢' },

        // Complex Salts (Requiring up to 6 atoms max to avoid screen clutter)
        { elements: ['C', 'a', 'C', 'l', 'Cl'], result: 'CaCl₂', name: 'Calcium Chloride', desc: 'બરફ પીગળાવવા વપરાય! ❄️' },
        { elements: ['M', 'g', 'C', 'l', 'Cl'], result: 'MgCl₂', name: 'Magnesium Chloride', desc: 'સ્વાસ્થ્ય માટે જરૂરી! 💊' },
        { elements: ['Z', 'n', 'S'], result: 'ZnS',  name: 'Zinc Sulfide', desc: 'અંધારામાં ચમકતું કમ્પાઉન્ડ! 🌟' },
        { elements: ['P', 'b', 'S'], result: 'PbS',  name: 'Lead Sulfide', desc: 'ગેલેના (Galena) ખનીજ! 🪨' },
        { elements: ['H', 'g', 'S'], result: 'HgS',  name: 'Mercury Sulfide', desc: 'સિંદૂર (Cinnabar)! 🔴' },
        { elements: ['S', 'i', 'O', 'O'], result: 'SiO₂', name: 'Silica', desc: 'રેતી અને કાચનો મુખ્ય ભાગ! 🏖️' }
    ];
      // --- 5. INITIALIZE ELEMENTS UI ---
    function initElements() {
        const list = document.getElementById('elementList');
        list.innerHTML = '';
        for (let key in elementData) {
            let el = elementData[key];
            let btn = document.createElement('div');
            btn.className = 'elem-btn';
            btn.onclick = () => addElement(key);
            btn.style.borderColor = el.color;
            btn.style.boxShadow = `0 0 5px ${el.color}`;
            btn.innerHTML = `${key}<div class="elem-name">${el.name}</div>`;
            list.appendChild(btn);
        }
    }

    // --- 6. ADD ATOM & UPDATE TRAY ---
    function updateSelectionTray() {
        if (selectedElementNames.length > 0) {
            selectionTray.innerHTML = selectedElementNames.join(' + ');
            selectionTray.style.display = 'block';
        } else {
            selectionTray.style.display = 'none';
        }
    }

    function addElement(type) {
        if(atoms.length >= 8) { playSound('error'); return; } // વધુમાં વધુ 8 તત્વો
        
        playSound('pop');
        
        atoms.push({
            type: type,
            x: Math.random() * (canvas.width - 60) + 30,
            y: -50,
            vx: (Math.random() - 0.5) * 4,
            vy: 0,
            radius: elementData[type].radius,
            color: elementData[type].color
        });
        
        selectedElementNames.push(type); // ટ્રે માં નામ ઉમેરો
        updateSelectionTray();
        
        if(atoms.length >= 2) mixBtn.style.display = 'block';
    }

    // --- 7. ANIMATION & PHYSICS ---
    function animate() {
        if(!isAnimating) { requestAnimationFrame(animate); isAnimating = true; }
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        for (let i = 0; i < atoms.length; i++) {
            let atom = atoms[i];
            atom.vy += 0.2; // Gravity
            
            // Wall bounce
            if (atom.x + atom.radius > canvas.width || atom.x - atom.radius < 0) {
                atom.vx *= -0.8;
                if(atom.x - atom.radius < 0) atom.x = atom.radius;
                if(atom.x + atom.radius > canvas.width) atom.x = canvas.width - atom.radius;
            }
            // Floor bounce
            if (atom.y + atom.radius > canvas.height) {
                atom.y = canvas.height - atom.radius;
                atom.vy *= -0.6;
                atom.vx *= 0.95; // Friction
            }
            
            atom.x += atom.vx;
            atom.y += atom.vy;
            drawAtom(atom);
        }
        requestAnimationFrame(animate);
    }

    function drawAtom(atom) {
        let grad = ctx.createRadialGradient(atom.x - atom.radius/3, atom.y - atom.radius/3, atom.radius/4, atom.x, atom.y, atom.radius);
        grad.addColorStop(0, '#fff');
        grad.addColorStop(0.3, atom.color);
        grad.addColorStop(1, '#000');
        
        ctx.beginPath();
        ctx.arc(atom.x, atom.y, atom.radius, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.shadowBlur = 10;
        ctx.shadowColor = atom.color;
        ctx.fill();
        ctx.shadowBlur = 0;

        ctx.fillStyle = "white";
        ctx.font = "bold 18px Arial";
        ctx.textAlign = "center";
        ctx.textBaseline = "middle";
        ctx.fillText(atom.type, atom.x, atom.y);
    }

    // --- 8. MIXING LOGIC ---
    function mixElements() {
        if (atoms.length < 2) return;
        let currentMix = atoms.map(a => a.type).sort();
        let foundRecipe = null;

        for (let recipe of recipes) {
            let recipeMix = [...recipe.elements].sort();
            if (JSON.stringify(currentMix) === JSON.stringify(recipeMix)) {
                foundRecipe = recipe;
                break;
            }
        }

        if (foundRecipe) {
            showResult(true, foundRecipe);
            playSound('success');
            score += 20;
            document.getElementById('scoreVal').innerText = score;
        } else {
            showResult(false, null);
            playSound('error');
        }
        resetLab(false);
    }

    // --- 9. RESULT & RESET ---
    function showResult(success, recipe) {
        const box = document.getElementById('resultBox');
        const title = document.getElementById('resultTitle');
        const desc = document.getElementById('resultDesc');
        
        box.style.display = 'block';
        
        if (success) {
            box.style.borderColor = '#00ff00';
            box.style.boxShadow = '0 0 50px rgba(0, 255, 0, 0.5)';
            title.innerHTML = `🎉 \u0AB8\u0AAB\u0AB3 \u0AAA\u0ACD\u0AB0\u0AAF\u0ACB\u0A97! (Success)`; 
            title.style.color = '#00ff00';
            desc.innerHTML = `
                <div style="font-size: 50px; margin: 10px;">⚗️</div>
                <h2 style="color:white; margin:5px;">${recipe.result}</h2>
                <h3 style="color:#00d2ff; margin:5px;">${recipe.name}</h3>
                <p style="color:#ccc;">${recipe.desc}</p>
            `;
        } else {
            box.style.borderColor = '#ff4757';
            box.style.boxShadow = '0 0 50px rgba(255, 71, 87, 0.5)';
            title.innerHTML = `💥 \u0AA8\u0ABF\u0AB7\u0ACD\u0AAB\u0AB3! (Failed)`; 
            title.style.color = '#ff4757';
            desc.innerHTML = `
                <div style="font-size: 50px; margin: 10px;">⚠️</div>
                <p style="color:white;">\u0A86 \u0AAE\u0ABF\u0AB6\u0ACD\u0AB0\u0AA3\u0AA5\u0AC0 \u0A95\u0A82\u0A88 \u0AAC\u0AA8\u0ACD\u0AAF\u0AC1\u0A82 \u0AA8\u0AB9\u0AC0\u0A82!</p>
                <p style="color:#888;">\u0AAC\u0AC0\u0A9C\u0AC1\u0A82 \u0A95\u0A82\u0A88\u0A95 \u0A9F\u0ACD\u0AB0\u0ABE\u0AAF \u0A95\u0AB0\u0ACB.</p>
            `;
        }
    }

    function closeResult() {
        document.getElementById('resultBox').style.display = 'none';
    }

    function resetLab(fullReset = true) {
        atoms = [];
        selectedElementNames = [];
        updateSelectionTray();
        mixBtn.style.display = 'none';
        if(fullReset) playSound('pop');
    }

    // --- 10. FULLSCREEN & STARTUP ---
    function resize() {
        if(wrapper) {
            canvas.width = wrapper.clientWidth;
            canvas.height = wrapper.clientHeight;
        }
    }
    window.addEventListener('resize', resize);
    
    function startGame() {
        document.getElementById('introScreen').style.display = 'none';
        
        // Enter Fullscreen
        if (wrapper.requestFullscreen) {
            wrapper.requestFullscreen().catch(err => console.log(err));
        } else if (wrapper.webkitRequestFullscreen) { /* Safari */
            wrapper.webkitRequestFullscreen();
        } else if (wrapper.msRequestFullscreen) { /* IE11 */
            wrapper.msRequestFullscreen();
        }

        if (audioCtx.state === 'suspended') audioCtx.resume();
        initElements();
        setTimeout(resize, 300); // Wait for fullscreen animation
        animate();
    }

    function exitGame() {
        // Exit Fullscreen
        if (document.exitFullscreen) {
            document.exitFullscreen();
        } else if (document.webkitExitFullscreen) { /* Safari */
            document.webkitExitFullscreen();
        } else if (document.msExitFullscreen) { /* IE11 */
            document.msExitFullscreen();
        }
        
        document.getElementById('introScreen').style.display = 'flex';
        resetLab(false);
        setTimeout(resize, 300);
    }

    // Handle Mobile 'Back' Button for Fullscreen
    document.addEventListener('fullscreenchange', exitHandler);
    document.addEventListener('webkitfullscreenchange', exitHandler);
    
    function exitHandler() {
        if (!document.fullscreenElement && !document.webkitIsFullScreen) {
            document.getElementById('introScreen').style.display = 'flex';
            resetLab(false);
            setTimeout(resize, 200);
        }
    }

    // Prevent random scrolling while tapping elements
    canvas.addEventListener('touchstart', (e) => e.preventDefault(), {passive: false});

</script>
