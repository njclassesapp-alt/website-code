        display: none; z-index: 30; 
        animation: pulseMix 2s infinite; /* નવું એનિમેશન નામ */
    }
    @keyframes pulseMix { 
        0% { transform: translateX(-50%) scale(1); } 
        50% { transform: translateX(-50%) scale(1.05); } 
        100% { transform: translateX(-50%) scale(1); } 
    }

    /* સ્ક્રીન બરાબર વચ્ચે રાખવા માટે Flexbox */
    .screen-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(5, 5, 16, 0.98); z-index: 100; pointer-events: auto;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
    }

    /* PLAY NOW બટનનું એનિમેશન અલગ કર્યું */
    .btn-main {
        background: linear-gradient(45deg, #ff9f43, #ee5253); border: none; padding: 15px 40px; color: white;
