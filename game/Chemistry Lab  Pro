        padding: 5px 20px; border-radius: 30px; color: white;
        font-size: 20px; font-weight: bold; text-shadow: 0 0 5px #00d2ff;
        backdrop-filter: blur(5px); display: none;
    }

    #elementScroll {
        pointer-events: auto; background: rgba(0,0,0,0.85); padding: 10px 0;
