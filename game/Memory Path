  <span><!--more--></span>
<div id="gameWrapper">
    <div id="timerContainer"><div id="timerBar"></div></div>
    
    <div id="topBar" class="ui-layer">
        <span><span class="ball-icon"></span> <span id="scoreVal">0</span> | Lvl: <span id="levelVal">1</span></span>
        <button id="exitBtn" class="exit-btn" onclick="exitFullscreen()">Exit ❌</button>
    </div>

    <div id="messageBox"></div>

    <canvas id="gameCanvas"></canvas>

    <div id="controls" style="display:none;">
        <div class="spacer"></div>
        <div class="ctrl-btn" onclick="movePlayer(0, -1)">▲</div>
        <div class="spacer"></div>
        <div class="ctrl-btn" onclick="movePlayer(-1, 0)">◀</div>
        <div class="ctrl-btn" onclick="movePlayer(0, 1)">▼</div>
        <div class="ctrl-btn" onclick="movePlayer(1, 0)">▶</div>
    </div>

    <div id="introScreen" class="screen-overlay">
        <div class="center-box">
            <h1 class="game-title"><span class="ball-icon ball-icon-large"></span> મેમરી પાથ PRO</h1>
            <p style="color:white; font-size: 16px;">લીલો રસ્તો યાદ રાખો અને ચાલો!</p>
            <button class="btn-glow" onclick="startGame()">PLAY NOW ▶️</button>
        </div>
    </div>

    <div id="gameOverScreen" class="screen-overlay" style="display: none; background: rgba(0,0,0,0.9);">
        <div class="center-box">
            <h1 class="game-title" style="color:#ff3333;"><span class="ball-icon ball-icon-large"></span> ખોટો રસ્તો!</h1>
            <h2 style="color: white;">સ્કોર: <span id="finalScore" style="color: #ffeb3b;">0</span></h2>
            <button class="btn-glow" onclick="startGame()">ફરી રમો 🔄</button>
        </div>
    </div>

    <div id="winScreen" class="screen-overlay" style="display: none; background: rgba(0,0,0,0.8);">
        <div class="center-box">
            <h1 class="game-title" style="color:#00ff00;"><span class="ball-icon ball-icon-large"></span> લેવલ પાર!</h1>
            <button class="btn-glow" onclick="nextRound()">આગળ વધો ➡</button>
        </div>
    </div>
</div>
<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const messageBox = document.getElementById('messageBox');
    const wrapper = document.getElementById('gameWrapper');
    const exitBtn = document.getElementById('exitBtn');
    
    let state = 'INTRO';
    let score = 0;
    let level = 1;
    let gridSize = 4;
    let tileSize = 60;
    let gap = 4;
    let path = [];
    let player = { x: 0, y: 0 };
    let memorizeTime = 2000;

    // --- Audio System ---
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    let audioCtx;
    function initAudio() {
        if (!audioCtx) audioCtx = new AudioContext();
        if (audioCtx.state === 'suspended') audioCtx.resume();
    }
    
    function playSound(type) {
        if (!audioCtx) return;
        const osc = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();
        osc.connect(gainNode);
        gainNode.connect(audioCtx.destination);
        const now = audioCtx.currentTime;

        if (type === 'move') {
            osc.type = 'sine'; osc.frequency.setValueAtTime(600, now);
            osc.frequency.exponentialRampToValueAtTime(300, now + 0.1);
            gainNode.gain.setValueAtTime(0.2, now); gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
            osc.start(now); osc.stop(now + 0.1);
        } else if (type === 'win') {
            osc.type = 'triangle'; osc.frequency.setValueAtTime(400, now);
            osc.frequency.setValueAtTime(600, now + 0.1); osc.frequency.setValueAtTime(800, now + 0.2);
            gainNode.gain.setValueAtTime(0.2, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.4);
            osc.start(now); osc.stop(now + 0.4);
        } else if (type === 'lose') {
            osc.type = 'sawtooth'; osc.frequency.setValueAtTime(150, now);
            osc.frequency.linearRampToValueAtTime(50, now + 0.3);
            gainNode.gain.setValueAtTime(0.3, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.3);
            osc.start(now); osc.stop(now + 0.3);
        } else if (type === 'start') {
            osc.type = 'square'; osc.frequency.setValueAtTime(200, now);
            osc.frequency.linearRampToValueAtTime(600, now + 0.3);
            gainNode.gain.setValueAtTime(0.1, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.3);
            osc.start(now); osc.stop(now + 0.3);
        }
    }

    // --- Fullscreen Logic ---
    function openFullscreen() {
        if (wrapper.requestFullscreen) { wrapper.requestFullscreen().catch(e=>console.log(e)); }
        else if (wrapper.webkitRequestFullscreen) { wrapper.webkitRequestFullscreen(); }
        else if (wrapper.msRequestFullscreen) { wrapper.msRequestFullscreen(); }
    }

    function exitFullscreen() {
        if (document.exitFullscreen) { document.exitFullscreen(); }
        else if (document.webkitExitFullscreen) { document.webkitExitFullscreen(); }
        else if (document.msExitFullscreen) { document.msExitFullscreen(); }
    }

    // જ્યારે ફુલ સ્ક્રીન થાય કે બંધ થાય ત્યારે આ ઇવેન્ટ કોલ થશે
    document.addEventListener('fullscreenchange', checkFullscreen);
    document.addEventListener('webkitfullscreenchange', checkFullscreen);

    function checkFullscreen() {
        if (!document.fullscreenElement && !document.webkitIsFullScreen) {
            // જો ફુલ સ્ક્રીનમાંથી બહાર આવે તો (દા.ત. Back બટન દબાવવાથી)
            exitBtn.style.display = 'none';
            document.getElementById('introScreen').style.display = 'flex';
            document.getElementById('controls').style.display = 'none';
            document.getElementById('gameOverScreen').style.display = 'none';
            document.getElementById('winScreen').style.display = 'none';
            state = 'INTRO';
            setTimeout(resize, 200);
        } else {
            // જો ફુલ સ્ક્રીન ચાલુ થાય તો એક્ઝિટ બટન બતાવો
            exitBtn.style.display = 'inline-block';
            setTimeout(resize, 200);
        }
    }

    // --- Game Logic ---
    function resize() {
        if(wrapper) {
            let w = wrapper.clientWidth;
            // ફુલ સ્ક્રીન હોય તો હાઈટ પૂરી લેશે, નહિ તો 140 કાપીને લેશે
            let h = wrapper.clientHeight - (document.fullscreenElement ? 100 : 140);
            let size = Math.min(w, h);
            if(size < 300) size = 300;
            canvas.width = size; canvas.height = size;
            tileSize = (canvas.width / gridSize) - gap;
            draw();
        }
    }
    window.addEventListener('resize', resize);
    
    window.onload = function() {
        resize();
        document.getElementById('introScreen').style.display = 'flex';
    };

    function startGame() {
        initAudio();
        playSound('start');
        openFullscreen(); // ગેમ સીધી ફુલ સ્ક્રીનમાં જશે!

        document.getElementById('introScreen').style.display = 'none';
        document.getElementById('gameOverScreen').style.display = 'none';
        score = 0; level = 1; gridSize = 4; 
        updateUI();
        
        // ફુલ સ્ક્રીન થયા પછી જ ગેમ રિસાઈઝ થઈને શરૂ થાય તે માટે
        setTimeout(() => {
            resize();
            startRound();
        }, 300);
    }

    function updateUI() {
        document.getElementById('scoreVal').innerText = score;
        document.getElementById('levelVal').innerText = level;
    }

    function startRound() {
        document.getElementById('winScreen').style.display = 'none';
        
        if(level <= 3) gridSize = 4;
        else if(level <= 6) gridSize = 5;
        else gridSize = 6;

        memorizeTime = 2000 - (level * 80); 
        if(memorizeTime < 800) memorizeTime = 800;

        resize();
        generateGrid();
        
        state = 'MEMORIZE';
        player.x = path[0].x;
        player.y = path[0].y;
        
        document.getElementById('timerBar').style.width = '100%';
        
        // ગુજરાતી યુનિકોડ (રસ્તો યાદ રાખો!)
        showMessage("\u0AB0\u0AB8\u0ACD\u0AA4\u0ACB \u0AAF\u0ABE\u0AA6 \u0AB0\u0ABE\u0A96\u0ACB!", true);
        document.getElementById('controls').style.display = 'none';

        draw();

        let startTime = Date.now();
        let timerInterval = setInterval(() => {
            if(state !== 'MEMORIZE') { clearInterval(timerInterval); return; }
            let elapsed = Date.now() - startTime;
            let percent = 100 - (elapsed / memorizeTime * 100);
            if(percent <= 0) {
                percent = 0; clearInterval(timerInterval); startPlayPhase();
            }
            document.getElementById('timerBar').style.width = percent + '%';
        }, 30);
    }

    function startPlayPhase() {
        state = 'PLAY';
        // ગુજરાતી યુનિકોડ (ચાલો!)
        showMessage("\u0A9A\u0ABE\u0AB2\u0ACB!", true);
        setTimeout(() => showMessage("", false), 800);
        document.getElementById('controls').style.display = 'grid';
        draw();
    }

    function showMessage(text, show) {
        messageBox.innerHTML = text; 
        messageBox.style.display = show ? 'block' : 'none';
    }

    function generateGrid() {
        path = [];
        let startX = Math.floor(Math.random() * gridSize);
        let current = { x: startX, y: gridSize - 1 };
        path.push({...current});

        while(current.y > 0) {
            let moves = [];
            moves.push({ x: current.x, y: current.y - 1 }); 
            if(current.x > 0) moves.push({ x: current.x - 1, y: current.y }); 
            if(current.x < gridSize - 1) moves.push({ x: current.x + 1, y: current.y }); 

            let nextMove;
            if(Math.random() > 0.4) nextMove = { x: current.x, y: current.y - 1 };
            else {
                 let sideMoves = moves.filter(m => m.y === current.y);
                 let validSides = sideMoves.filter(sm => !path.some(p => p.x === sm.x && p.y === sm.y));
                 if(validSides.length > 0) nextMove = validSides[Math.floor(Math.random() * validSides.length)];
                 else nextMove = { x: current.x, y: current.y - 1 };
            }
            if(path.some(p => p.x === nextMove.x && p.y === nextMove.y)) nextMove = { x: current.x, y: current.y - 1 };
            current = nextMove;
            path.push({...current});
        }
    }

    function movePlayer(dx, dy) {
        if(state !== 'PLAY') return;
        if(navigator.vibrate) navigator.vibrate(10);
        playSound('move');
        
        let newX = player.x + dx; let newY = player.y + dy;
        if(newX < 0 || newX >= gridSize || newY < 0 || newY >= gridSize) return;
        player.x = newX; player.y = newY;
        checkStep(); draw();
    }

    function checkStep() {
        let isPath = path.some(p => p.x === player.x && p.y === player.y);
        if(isPath) {
            if(player.y === 0) {
                state = 'WIN'; score += 10; updateUI();
                if(navigator.vibrate) navigator.vibrate([50, 50]);
                playSound('win');
                setTimeout(() => document.getElementById('winScreen').style.display = 'flex', 200);
            }
        } else {
            state = 'GAMEOVER';
            document.getElementById('finalScore').innerText = score;
            if(navigator.vibrate) navigator.vibrate(200);
            playSound('lose');
            setTimeout(() => document.getElementById('gameOverScreen').style.display = 'flex', 300);
        }
    }

    function nextRound() { level++; updateUI(); startRound(); }

    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let totalGridSize = gridSize * (tileSize + gap);
        let offsetX = (canvas.width - totalGridSize) / 2;
        let offsetY = (canvas.height - totalGridSize) / 2;

        for(let y=0; y<gridSize; y++) {
            for(let x=0; x<gridSize; x++) {
                let px = offsetX + x * (tileSize + gap);
                let py = offsetY + y * (tileSize + gap);
                
                ctx.fillStyle = "rgba(0, 20, 60, 0.5)"; 
                ctx.strokeStyle = "#00ffff"; ctx.lineWidth = 1;
                let isPath = path.some(p => p.x === x && p.y === y);
                
                if(state === 'MEMORIZE' && isPath) {
                    ctx.fillStyle = "rgba(0, 255, 0, 0.6)";
                    ctx.shadowColor = "#00ff00"; ctx.shadowBlur = 10;
                } else if (state === 'GAMEOVER' && player.x === x && player.y === y && !isPath) {
                    ctx.fillStyle = "rgba(255, 0, 0, 0.7)";
                    ctx.shadowColor = "#ff0000"; ctx.shadowBlur = 15;
                } else {
                    ctx.shadowBlur = 0;
                }
                ctx.fillRect(px, py, tileSize, tileSize);
                ctx.strokeRect(px, py, tileSize, tileSize);
            }
        }

        if(state === 'PLAY' || state === 'MEMORIZE' || state === 'WIN') {
            let px = offsetX + player.x * (tileSize + gap) + tileSize/2;
            let py = offsetY + player.y * (tileSize + gap) + tileSize/2;
            
            let bounce = Math.sin(Date.now() / 150) * 3;
            let ballSize = tileSize/3;
            let ballY = py - 5 + bounce;

            ctx.fillStyle = "rgba(0,0,0,0.5)";
            ctx.beginPath();
            ctx.ellipse(px, py + ballSize, ballSize, ballSize/3, 0, 0, Math.PI*2);
            ctx.fill();

            let grad = ctx.createRadialGradient(px - 5, ballY - 10, 2, px, ballY, ballSize);
            grad.addColorStop(0, "#fff");
            grad.addColorStop(0.3, "#ffeb3b");
            grad.addColorStop(1, "#ff9800");
            
            ctx.fillStyle = grad;
            ctx.shadowColor = "#ffeb3b"; ctx.shadowBlur = 10;
            ctx.beginPath();
            ctx.arc(px, ballY, ballSize, 0, Math.PI*2);
            ctx.fill();
            
            ctx.fillStyle = "black"; ctx.shadowBlur = 0;
            ctx.beginPath();
            ctx.arc(px - 6, ballY - 4, 3, 0, Math.PI*2);
            ctx.arc(px + 6, ballY - 4, 3, 0, Math.PI*2);
            ctx.fill();
            
            ctx.fillStyle = "white";
            ctx.beginPath();
            ctx.arc(px - 7, ballY - 5, 1, 0, Math.PI*2);
            ctx.arc(px + 5, ballY - 5, 1, 0, Math.PI*2);
            ctx.fill();
        }
        requestAnimationFrame(draw);
    }
    
    resize();
    requestAnimationFrame(draw);
</script>
</body>
