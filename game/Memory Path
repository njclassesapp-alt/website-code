<!DOCTYPE html>
<html lang="gu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Memory Path 3D - Fullscreen</title>
<style>
    @import url('https://fonts.googleapis.com/css2?family=Hind+Vadodara:wght@700&display=swap');

    body {
        margin: 0; padding: 0; background: transparent;
        font-family: 'Hind Vadodara', sans-serif; text-align: center;
        user-select: none; -webkit-user-select: none;
    }

    .post-header-img {
        max-width: 100%; height: auto; border-radius: 10px;
        margin-bottom: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    /* ફુલ સ્ક્રીન સપોર્ટવાળું રેપર (Wrapper) */
    #gameWrapper {
        position: relative; width: 100%; max-width: 600px; 
        height: 70vh; min-height: 400px; max-height: 550px;
        margin: 0 auto; background: linear-gradient(135deg, #0b0f2f, #1c1c5a);
        border-radius: 15px; border: 4px solid #00ffff;
        overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        touch-action: manipulation;
    }

    /* ફુલ સ્ક્રીન થાય ત્યારે બોર્ડર અને માર્જિન કાઢી નાખવા */
    #gameWrapper:fullscreen { max-width: 100%; height: 100%; border-radius: 0; border: none; margin: 0; }
    #gameWrapper:-webkit-full-screen { max-width: 100%; height: 100%; border-radius: 0; border: none; margin: 0; }
    #gameWrapper:-ms-fullscreen { max-width: 100%; height: 100%; border-radius: 0; border: none; margin: 0; }

    canvas { display: block; width: 100%; height: 100%; }

    .ui-layer {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        pointer-events: none; display: flex; flex-direction: column; justify-content: space-between;
        z-index: 20;
    }

    #topBar {
        padding: 10px 20px; display: flex; justify-content: space-between; align-items: center;
        color: #00ffff; font-size: 18px; font-weight: bold; background: rgba(0,0,0,0.5);
        pointer-events: auto; /* બટન ક્લિક કરવા માટે */
    }

    /* નવું એક્ઝિટ બટન */
    .exit-btn {
        background: #ff4757; color: white; border: 1px solid white;
        padding: 5px 15px; border-radius: 20px; font-size: 14px; cursor: pointer;
        display: none; /* શરૂઆતમાં છુપાયેલું */
    }

    .ball-icon {
        display: inline-block; width: 20px; height: 20px;
        background: radial-gradient(circle at 30% 30%, #fff, #ffeb3b, #ff9800);
        border-radius: 50%; vertical-align: middle; box-shadow: 0 0 5px #ff9800; margin-right: 5px;
    }
    .ball-icon-large { width: 40px; height: 40px; margin: 0 10px; }

    #timerContainer { width: 100%; height: 6px; background: rgba(255,255,255,0.1); position: absolute; top: 0; z-index: 25; }
    #timerBar { width: 100%; height: 100%; background: #00ff00; transition: width 0.1s linear; }

    #messageBox {
        position: absolute; top: 20%; left: 50%; transform: translate(-50%, -50%);
        background: rgba(0, 0, 0, 0.85); color: #ffeb3b; padding: 8px 20px; border-radius: 20px;
        font-size: 22px; font-weight: bold; border: 2px solid #ffeb3b; z-index: 15; white-space: nowrap; display: none;
    }

    #controls {
        position: absolute; bottom: 15px; left: 50%; transform: translateX(-50%); display: grid; 
        grid-template-columns: 60px 60px 60px; grid-template-rows: 60px 60px; gap: 8px; pointer-events: auto; z-index: 50;
    }
    .ctrl-btn {
        width: 60px; height: 60px; background: rgba(0, 40, 80, 0.7); border: 2px solid #00ffff;
        border-radius: 50%; color: #00ffff; font-size: 24px; display: flex; align-items: center; justify-content: center;
        cursor: pointer; box-shadow: 0 0 10px rgba(0, 255, 255, 0.3); transition: transform 0.1s;
    }
    .ctrl-btn:active { background: rgba(0, 255, 255, 0.2); transform: scale(0.9); }
    .spacer { visibility: hidden; }

    .screen-overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(5, 5, 16, 0.98);
        z-index: 100; display: flex; flex-direction: column; align-items: center; justify-content: center;
        text-align: center; pointer-events: auto;
    }

    .center-box { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 100%; text-align: center; }

    .game-title { font-size: 30px; color: #ffeb3b; margin-bottom: 20px; text-shadow: 0 0 10px #ff9800; display: flex; align-items: center; justify-content: center; gap: 10px; }

    .btn-glow {
        background: linear-gradient(45deg, #ff9800, #ff5722); border: none; padding: 12px 40px; color: white;
        font-size: 20px; border-radius: 50px; cursor: pointer; font-weight: bold; box-shadow: 0 0 20px rgba(255, 87, 34, 0.6);
        animation: pulseMain 1.5s infinite;
    }
    @keyframes pulseMain { 0% { transform: scale(1); } 50% { transform: scale(1.05); } 100% { transform: scale(1); } }
</style>
</head>
<body>

<div class="separator" style="clear: both; text-align: center;">
